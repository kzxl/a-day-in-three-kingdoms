<Window x:Class="SimT.Host.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SimT.Host.Wpf"
        xmlns:controls="clr-namespace:SimT.Host.Wpf.Controls"
        xmlns:scenes="clr-namespace:SimT.Host.Wpf.Scenes"
        Title="Một Ngày Ở Tam Quốc" Height="880" Width="1380"
        MinHeight="720" MinWidth="1024"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">

    <Window.Resources>
        <DataTemplate x:Key="AlertRow">
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,6">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="3" CornerRadius="2"
                            Background="{Binding Accent}" Margin="0,1,10,1" />
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                               Style="{StaticResource Caption}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Tier 1: Top Strategic Command Banner -->
            <RowDefinition Height="54" />
            <!-- Tier 2: Central Strategic Arena (Left Command Ribbon + Central Viewport) -->
            <RowDefinition Height="*" />
            <!-- Tier 3: Bottom Tactical Console (Advisor Speech Box) -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Legacy / Compat components kept collapsed for zero-regression -->
        <controls:GameChronoCard x:Name="ChronoCard" Visibility="Collapsed" />
        <controls:GamePlayerHudCard x:Name="PlayerHudCard" Visibility="Collapsed" />
        <controls:GameTreasuryCard x:Name="TreasuryCard" Visibility="Collapsed" />
        <controls:GameButton x:Name="AdvanceButton" Visibility="Collapsed" Click="Advance_Click" />

        <!-- ===== TIER 1: Top Strategic Command Banner ===== -->
        <Border Grid.Row="0" Background="{StaticResource Rail}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="14,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Logo & Player Identity Token -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Accent}"
                            BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="TAM QUỐC" FontFamily="Noto Serif, Georgia, Segoe UI"
                                   FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                    </Border>

                    <Border x:Name="CompactPlayerCard" Background="{StaticResource SurfaceAlt}"
                            BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5"
                            Padding="10,4" Cursor="Hand" MouseLeftButtonDown="PlayerCard_Click"
                            ToolTip="Bấm để mở hồ sơ chi tiết nhân vật">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M12,12 A4,4 0 1,0 12,4 A4,4 0 1,0 12,12 M4,20 C4,16.5 7.5,14 12,14 C16.5,14 20,16.5 20,20"
                                  Stroke="{StaticResource Accent}" StrokeThickness="1.5" Width="13" Height="13"
                                  Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="CompactPlayerNameText" FontWeight="Bold" FontSize="12.5"
                                       Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                            <TextBlock Text=" · " Foreground="{StaticResource Faint}" VerticalAlignment="Center" />
                            <TextBlock x:Name="CompactLocationText" Style="{StaticResource Caption}"
                                       Foreground="{StaticResource Accent}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Center: Strategic Imperial Chronicle & Vitals Strip -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <controls:GameCalendarBar x:Name="CalendarBar" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock x:Name="CompactDateText" Visibility="Collapsed" />

                    <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                            BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M12,2 A10,10 0 1,0 12,22 A10,10 0 1,0 12,2 M12,6 L12,18 M8,9 C8,7.5 9.5,7 12,7 C14.5,7 16,8 16,9.5 C16,11 14,11.5 12,12 C10,12.5 8,13 8,14.5 C8,16 9.5,17 12,17 C14.5,17 16,16.5 16,15"
                                  Stroke="{StaticResource Accent}" StrokeThickness="1.2" Width="12" Height="12" Stretch="Uniform"
                                  Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="CompactMoneyText" Style="{StaticResource Number}"
                                       Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                            BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Thể lực" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <Grid Width="65" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Border Background="#1C281F" CornerRadius="3" />
                                <Border x:Name="VisualStaminaFill" Background="#34D399" CornerRadius="3" HorizontalAlignment="Left" Width="40" />
                            </Grid>
                            <TextBlock x:Name="VisualStaminaText" Text="--/--" FontSize="11" FontWeight="SemiBold" Foreground="#34D399" Margin="0,0,12,0" VerticalAlignment="Center" />

                            <TextBlock Text="Mệt" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <Grid Width="55" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Border Background="#2B1A14" CornerRadius="3" />
                                <Border x:Name="VisualFatigueFill" Background="#F59E0B" CornerRadius="3" HorizontalAlignment="Left" Width="30" />
                            </Grid>
                            <TextBlock x:Name="VisualFatigueText" Text="--%" FontSize="11" FontWeight="SemiBold" Foreground="#F59E0B" Margin="0,0,12,0" VerticalAlignment="Center" />

                            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                                    BorderThickness="1" CornerRadius="3" Padding="6,1" VerticalAlignment="Center">
                                <TextBlock x:Name="VisualStandingText" Text="Bách Tính" FontSize="10.5"
                                           Foreground="{StaticResource Accent}" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="CompactVitalsText" Visibility="Collapsed" />
                </StackPanel>

                <!-- Right: System Utility Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="CampaignText" Style="{StaticResource Caption}" Foreground="{StaticResource Faint}"
                               VerticalAlignment="Center" Margin="0,0,10,0" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" Foreground="{StaticResource Faint}"
                               FontSize="10" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <controls:GameButton Label="Cài đặt" Variant="Secondary" IsCompact="True"
                                         IconPathData="M12,8 A4,4 0 1,0 12,16 A4,4 0 1,0 12,8 M12,2 L12,5 M12,19 L12,22 M2,12 L5,12 M19,12 L22,12 M4.9,4.9 L7,7 M17,17 L19.1,19.1 M19.1,4.9 L17,7 M7,17 L4.9,19.1"
                                         Click="Settings_Click" VerticalAlignment="Center"
                                         ToolTip="Quản lý DLC Tam Quốc, kiểm tra toàn vẹn Invariants &amp; tùy chọn game" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== TIER 2: Central Strategic Arena ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Left Command Ribbon Dock ===== -->
            <Border Grid.Column="0" Background="{StaticResource Rail}"
                    BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <Grid Margin="10,10,10,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="4,0,4,6">
                        <TextBlock Text="MỆNH LỆNH CHÍNH SỰ" Style="{StaticResource Overline}"
                                   Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,6">
                        <controls:GameCommandRibbon x:Name="StrategicRibbon" Width="200" />
                    <!-- Section Header -->
                    <Border Grid.Row="0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="2,0,2,8" Margin="0,0,0,8">
                        <DockPanel>
                            <TextBlock Text="⚔️" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="QUÂN CƠ CHÍNH SỰ" Style="{StaticResource Overline}"
                                       Foreground="{StaticResource Accent}" FontWeight="Bold" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <!-- Strategic Command Ribbon (ROTK-inspired 5 Master Category Tabs) -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Padding="0" Margin="0,0,0,6" Focusable="False">
                        <controls:GameCommandRibbon x:Name="StrategicRibbon" Width="200" HorizontalAlignment="Center" />
                    </ScrollViewer>

                    <ListBox x:Name="NavList" Grid.Row="1" Visibility="Collapsed" SelectionChanged="Nav_SelectionChanged" />

                    <StackPanel Grid.Row="2" Margin="0,6,0,0">
                        <controls:GameSealButton x:Name="SealAdvanceButton" Shape="Square" Width="200" Height="50"
                                                 SealLabel="QUA NGÀY" SubLabel="+1 Ngày"
                                                 HorizontalAlignment="Center" Margin="0,0,0,6"
                                                 Click="Advance_Click"
                                                 ToolTip="Bấm để thúc đẩy thời gian sang ngày tiếp theo (Phím Space / Enter)" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:GameButton x:Name="RestButton" Grid.Column="0" Label="Nghỉ ngơi" Variant="Secondary"
                                                 IconPathData="M18,14 A7,7 0 0,1 10,6 A7,7 0 1,0 18,14 Z"
                                                 Click="Rest_Click" HorizontalContentAlignment="Center" IsCompact="True"
                                                 ToolTip="Nghỉ ngơi tĩnh dưỡng 1 ngày (hồi phục thể lực và giảm mệt mỏi)" />
                            <controls:GameButton x:Name="AdvanceWeekButton" Grid.Column="2" Label="Tuần +7" Variant="Secondary"
                                                 IconPathData="M5,6 L12,12 L5,18 M12,6 L19,12 L12,18"
                                                 Click="AdvanceWeek_Click" HorizontalContentAlignment="Center" IsCompact="True"
                                                 ToolTip="Thúc đẩy 1 tuần (+7 ngày)" />
                        </Grid>

                        <controls:GameButton x:Name="StrollButton" Visibility="Collapsed" Click="Stroll_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Central Page Workspace ===== -->
            <Grid x:Name="PageRoot" Grid.Column="1" Margin="22,14,22,10" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="PageTransform" Y="0" />
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="False">
                    <controls:GameProposalCard x:Name="TopProposalCard" DockPanel.Dock="Right" Margin="14,0,0,0"
                                               VerticalAlignment="Top" Visibility="Collapsed"
                                               ActionClick="ProposalAction_Click"
                                               DismissClick="ProposalDismiss_Click" />

                    <StackPanel DockPanel.Dock="Right" Width="200" Margin="14,0,0,0" VerticalAlignment="Top">
                        <TextBlock Text="LỌC DÒNG" Style="{StaticResource Overline}" Margin="0,0,0,3" />
                        <Grid>
                            <TextBox x:Name="FilterBox" Visibility="Collapsed"
                                     ToolTip="Gõ để lọc các dòng của màn này (Ctrl+F)"
                                     TextChanged="Filter_TextChanged" />
                            <TextBlock x:Name="FilterHint" Text="tên vật phẩm, thành…"
                                       Foreground="{StaticResource Faint}" FontSize="11"
                                       Margin="8,0,0,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False" Visibility="Collapsed" />
                        </Grid>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock x:Name="ScreenTitle" Style="{StaticResource H1}" />
                        <TextBlock x:Name="ScreenStatus" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                    </StackPanel>
                </DockPanel>

                <controls:GameTabs x:Name="ScreenGroupTabs" Grid.Row="1" Margin="0,6,0,0" />

                <!-- "Nên làm" contextual recommendation bar -->
                <Border x:Name="RecommendationBanner" Grid.Row="2" Margin="0,8,0,0" Padding="12,8"
                        Background="#221A12" BorderBrush="#4A3924" BorderThickness="1" CornerRadius="5"
                        Visibility="Collapsed">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="3" CornerRadius="2"
                                Background="{StaticResource Accent}" Margin="0,1,10,1" />
                        <Border DockPanel.Dock="Left" Background="#2A1F12" BorderBrush="#6B5330"
                                BorderThickness="1" CornerRadius="3" Padding="7,2" Margin="0,0,10,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="NÊN LÀM" FontSize="10" FontWeight="Bold"
                                       Foreground="#E2C27D" />
                        </Border>
                        <TextBlock x:Name="RecommendationText" Foreground="{StaticResource Ink}"
                                   FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <WrapPanel x:Name="KpiStrip" Grid.Row="3" Margin="0,10,0,0" />

                <ItemsControl x:Name="AlertFeed" Grid.Row="4" Margin="0,4,0,0"
                              ItemTemplate="{StaticResource AlertRow}" />

                <StackPanel x:Name="GlobalCommands" Grid.Row="5" Orientation="Horizontal" Margin="0,10,0,0" />

                <ScrollViewer Grid.Row="6" Margin="0,10,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ContentPanel" />
                </ScrollViewer>

                <Border Grid.Row="7" Visibility="Collapsed">
                    <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" Text="Sẵn sàng." />
                </Border>
            </Grid>

            <!-- ===== WebView2 Scene Overlay ===== -->
            <scenes:SceneOverlayControl x:Name="SceneOverlay" Grid.Column="1" Panel.ZIndex="15" Visibility="Collapsed" />
            <controls:GameDebugOverlayControl x:Name="DebugOverlay" Grid.Column="1" Panel.ZIndex="99" Visibility="Collapsed" />

            <!-- ===== Inspector: overlays the page ===== -->
            <Border x:Name="InspectorScrim" Grid.Column="1" Panel.ZIndex="19" Visibility="Collapsed"
                    Background="#66000000" MouseLeftButtonDown="Scrim_Click" />

            <Border x:Name="InspectorPanel" Grid.Column="1" Panel.ZIndex="20" Width="380"
                    HorizontalAlignment="Right" Visibility="Collapsed"
                    Background="{StaticResource Rail}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1,0,0,0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="InspectorTransform" X="380" />
                </Border.RenderTransform>
                <Grid Margin="18,18,18,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <controls:GameButton DockPanel.Dock="Right" Variant="Icon" IsCompact="True"
                                             IconPathData="M6,6 L18,18 M18,6 L6,18"
                                             Click="CloseInspector_Click" />
                        <TextBlock Text="CHI TIẾT" Style="{StaticResource Overline}" VerticalAlignment="Center" />
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="InspectorBody" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Floating Feedback Canvas & Toast Notification Host -->
            <Canvas x:Name="FloatingCanvas" Grid.Column="1" Panel.ZIndex="24" IsHitTestVisible="False" ClipToBounds="True" />
            <controls:GameToastHost x:Name="ToastHost" Grid.Column="1" Panel.ZIndex="25" />
        </Grid>

        <!-- ===== TIER 3: Bottom Tactical Console ===== -->
        <Border Grid.Row="2" Background="{StaticResource Rail}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="14,6">
            <controls:GameAdvisorBox x:Name="StrategicAdvisorBox"
                                     AdvisorName="QUẢN GIA THƯƠNG HỘI"
                                     AdvisorTitle="Túc Trí Tham Mưu"
                                     AvatarInitials="Sư"
                                     AdviceMessage="Thương trường như chiến trường. Nắm bắt quy luật cung cầu sẽ giúp đại nhân một bước thành cự phú."
                                     ActionButtonLabel="Xem Chợ"
                                     ActionClick="AdvisorAction_Click" />
        </Border>
    </Grid>
</Window>
