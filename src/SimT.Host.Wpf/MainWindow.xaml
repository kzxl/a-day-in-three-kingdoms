<Window x:Class="SimT.Host.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SimT.Host.Wpf"
        xmlns:controls="clr-namespace:SimT.Host.Wpf.Controls"
        xmlns:scenes="clr-namespace:SimT.Host.Wpf.Scenes"
        Title="Một Ngày Ở Tam Quốc" Height="880" Width="1380"
        MinHeight="720" MinWidth="1160"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- Typed DataTemplate for intelligent cell rendering (badges, durability meters, monospace numbers) -->
        <DataTemplate DataType="{x:Type local:CellVm}">
            <Grid Margin="2,1">
                <!-- Case 1: Progress / Gauge Meter (Durability or Level) -->
                <Grid Visibility="{Binding ProgressVisibility}" Width="110" HorizontalAlignment="Left">
                    <ProgressBar Height="14" Minimum="0" Maximum="{Binding ProgressMax, Mode=OneWay}" Value="{Binding ProgressValue, Mode=OneWay}"
                                 Foreground="{Binding ProgressBrush}" Background="#241A13"
                                 BorderBrush="#3A2C20" BorderThickness="1" />
                    <TextBlock Text="{Binding Text}" FontSize="10" FontWeight="SemiBold"
                               Foreground="#F3E6CC" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <!-- Case 2: Badge Pill -->
                <Border Visibility="{Binding BadgeVisibility}"
                        Background="{Binding BadgeBackground}"
                        BorderBrush="{Binding BadgeBorder}"
                        BorderThickness="1" CornerRadius="4" Padding="6,2"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Text}"
                               Foreground="{Binding BadgeForeground}"
                               FontSize="11" FontWeight="SemiBold" />
                </Border>

                <!-- Case 3: Standard Text / Monospace Numeric -->
                <TextBlock Visibility="{Binding NormalTextVisibility}"
                           Text="{Binding Text}"
                           TextAlignment="{Binding TextAlignment}"
                           FontFamily="{Binding FontFamily}"
                           Foreground="{Binding TextForeground}"
                           VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
        <!-- Row chips come from the screen model, so the host never hard-codes a verb. -->
        <DataTemplate x:Key="ActionsCell">
            <ItemsControl ItemsSource="{Binding Chips}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{Binding Style}"
                                Content="{Binding Label}"
                                Tag="{Binding Id}"
                                Click="RowCommand_Click" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
        <DataTemplate x:Key="DetailCell">
            <Button Style="{StaticResource ChipButton}" Click="OpenDetail_Click"
                    ToolTip="Xem chi tiết dòng này (double-click hoặc Enter)">
                <Path Data="M4,12 A1.5,1.5 0 1,0 4,12.1 M12,12 A1.5,1.5 0 1,0 12,12.1 M20,12 A1.5,1.5 0 1,0 20,12.1"
                      Stroke="{StaticResource Accent}" StrokeThickness="2" Width="14" Height="10" Stretch="Uniform" />
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="AlertRow">
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,6">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="3" CornerRadius="2"
                            Background="{Binding Accent}" Margin="0,1,10,1" />
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                               Style="{StaticResource Caption}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="276" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Left Rail: Compact player summary, grouped screens (no scrolling needed), actions ===== -->
        <Border Grid.Column="0" Background="{StaticResource Rail}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <Grid Margin="14,14,14,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <Button DockPanel.Dock="Right" Click="Settings_Click"
                            Style="{StaticResource GhostButton}" Padding="8,4" MinHeight="32" FontSize="11" VerticalAlignment="Center"
                            ToolTip="Quản lý DLC Tam Quốc, kiểm tra toàn vẹn Invariants &amp; tùy chọn game">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M12,8 A4,4 0 1,0 12,16 A4,4 0 1,0 12,8 M12,2 L12,5 M12,19 L12,22 M2,12 L5,12 M19,12 L22,12 M4.9,4.9 L7,7 M17,17 L19.1,19.1 M19.1,4.9 L17,7 M7,17 L4.9,19.1"
                                  Stroke="{StaticResource Accent}" StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="Cài đặt" FontSize="11.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="MỘT NGÀY Ở TAM QUỐC" FontFamily="Noto Serif, Georgia, Segoe UI"
                                   FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                        <TextBlock x:Name="CampaignText" Style="{StaticResource Caption}" Margin="0,1,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>

                <!-- Compact single player card replacing the 3 tall HUD cards -->
                <Border x:Name="CompactPlayerCard" Grid.Row="1" Margin="0,10,0,4" Padding="11,8"
                        Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="6" Cursor="Hand"
                        MouseLeftButtonDown="PlayerCard_Click"
                        ToolTip="Bấm để mở hồ sơ chi tiết nhân vật">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock x:Name="CompactLocationText" DockPanel.Dock="Right"
                                       Style="{StaticResource Caption}" Foreground="{StaticResource Accent}"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M12,12 A4,4 0 1,0 12,4 A4,4 0 1,0 12,12 M4,20 C4,16.5 7.5,14 12,14 C16.5,14 20,16.5 20,20"
                                      Stroke="{StaticResource Accent}" StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="CompactPlayerNameText" FontWeight="SemiBold"
                                           Foreground="{StaticResource Ink}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Margin="0,5,0,0">
                            <TextBlock x:Name="CompactMoneyText" DockPanel.Dock="Right"
                                       Style="{StaticResource Number}" Foreground="{StaticResource Accent}"
                                       FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock x:Name="CompactDateText" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <TextBlock x:Name="CompactVitalsText" Style="{StaticResource Caption}"
                                   Foreground="{StaticResource Faint}" FontSize="10.5" Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- Legacy cards kept collapsed for compatibility -->
                <controls:GameChronoCard x:Name="ChronoCard" Grid.Row="2" Visibility="Collapsed" />
                <controls:GamePlayerHudCard x:Name="PlayerHudCard" Grid.Row="2" Visibility="Collapsed" />
                <controls:GameTreasuryCard x:Name="TreasuryCard" Grid.Row="3" Visibility="Collapsed" />

                <!-- Grouped navigation list (2-column grid per group so all 18 screens fit without scrolling) -->
                <ListBox x:Name="NavList" Grid.Row="4" Margin="0,4,0,0"
                         ItemContainerStyle="{StaticResource NavItem}"
                         SelectionChanged="Nav_SelectionChanged">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Overline}"
                                               Foreground="{StaticResource Accent}" Margin="4,7,0,2" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                            <GroupStyle.Panel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </GroupStyle.Panel>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Data="{Binding IconGeometry}"
                                      Stroke="{StaticResource Accent}" StrokeThickness="1.4"
                                      Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"
                                      VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}"
                                           FontSize="12" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="2" Background="{StaticResource AccentSoft}"
                                        CornerRadius="8" Padding="5,1" Margin="3,0,0,0"
                                        Visibility="{Binding BadgeVisibility}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Badge}" FontSize="9.5"
                                               Foreground="{StaticResource Accent}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="5" Margin="0,8,0,0">
                    <Button x:Name="AdvanceButton" Click="Advance_Click"
                            Style="{StaticResource PrimaryButton}" HorizontalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M8,5 L18,12 L8,19 Z" Fill="#1A120B" Width="11" Height="11" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Text="Ngày tiếp" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="RestButton" Grid.Column="0" Click="Rest_Click"
                                Style="{StaticResource GhostButton}" HorizontalContentAlignment="Center"
                                ToolTip="Nghỉ ngơi tĩnh dưỡng 1 ngày (hồi phục thể lực và giảm mệt mỏi)">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M18,14 A7,7 0 0,1 10,6 A7,7 0 1,0 18,14 Z"
                                      Stroke="{StaticResource Accent}" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Nghỉ ngơi" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="AdvanceWeekButton" Grid.Column="2" Click="AdvanceWeek_Click"
                                Style="{StaticResource GhostButton}" HorizontalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M5,6 L12,12 L5,18 M12,6 L19,12 L12,18"
                                      Stroke="{StaticResource Accent}" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Tuần +7" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Button x:Name="StrollButton" Margin="0,5,0,0" Click="Stroll_Click"
                            Style="{StaticResource GhostButton}" HorizontalContentAlignment="Center"
                            ToolTip="Tản bộ ngắm cảnh thành trì, tìm kiếm kỳ ngộ, tao ngộ danh sĩ và sự kiện ngẫu nhiên (-12 Căng thẳng, +5 Thể lực)">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M12,2 A10,10 0 1,0 12,22 A10,10 0 1,0 12,2 M15,9 L9,15 M15,9 L10,10 L9,15 L14,14 Z"
                                  Stroke="{StaticResource Accent}" StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Du ngoạn phố" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" Margin="0,6,0,0"
                               Foreground="{StaticResource Faint}" FontSize="10" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Page ===== -->
        <Grid Grid.Column="1" Margin="26,20,26,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Width="220" Margin="16,0,0,0" VerticalAlignment="Top">
                    <TextBlock Text="LỌC DÒNG" Style="{StaticResource Overline}" Margin="0,0,0,4" />
                    <Grid>
                        <TextBox x:Name="FilterBox" Visibility="Collapsed"
                                 ToolTip="Gõ để lọc các dòng của màn này (Ctrl+F)"
                                 TextChanged="Filter_TextChanged" />
                        <TextBlock x:Name="FilterHint" Text="tên vật phẩm, thành, trạng thái…"
                                   Foreground="{StaticResource Faint}" FontSize="11.5"
                                   Margin="10,0,0,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False" Visibility="Collapsed" />
                    </Grid>
                </StackPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock x:Name="ScreenTitle" Style="{StaticResource H1}" />
                    <TextBlock x:Name="ScreenStatus" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- Tactical 30-day timeline with animated day sliding -->
            <controls:GameCalendarBar x:Name="CalendarBar" Grid.Row="1" Margin="0,10,0,0" />

            <WrapPanel x:Name="KpiStrip" Grid.Row="2" Margin="0,12,0,0" />

            <ItemsControl x:Name="AlertFeed" Grid.Row="3" Margin="0,4,0,0"
                          ItemTemplate="{StaticResource AlertRow}" />

            <StackPanel x:Name="GlobalCommands" Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0" />

            <ScrollViewer Grid.Row="5" Margin="0,14,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ContentPanel" />
            </ScrollViewer>

            <Border Grid.Row="6" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="6" Padding="12,9" Margin="0,12,0,0">
                <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" Text="Sẵn sàng." />
            </Border>
        </Grid>

        <!-- ===== WebView2 Scene Overlay (2.5D Talk / Pixel Duel / City Hub) ===== -->
        <scenes:SceneOverlayControl x:Name="SceneOverlay" Grid.Column="1" Panel.ZIndex="15" Visibility="Collapsed" />

        <!-- ===== Inspector: overlays the page so opening it never reflows the grid ===== -->
        <Border x:Name="InspectorScrim" Grid.Column="1" Panel.ZIndex="19" Visibility="Collapsed"
                Background="#66000000" MouseLeftButtonDown="Scrim_Click" />

        <Border x:Name="InspectorPanel" Grid.Column="1" Panel.ZIndex="20" Width="360"
                HorizontalAlignment="Right" Visibility="Collapsed"
                Background="{StaticResource Rail}" BorderBrush="{StaticResource Line}"
                BorderThickness="1,0,0,0">
            <Grid Margin="18,20,18,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <Button DockPanel.Dock="Right" Click="CloseInspector_Click"
                            Style="{StaticResource GhostButton}" Padding="8,2" MinHeight="28" FontSize="11">
                        <Path Data="M6,6 L18,18 M18,6 L6,18" Stroke="{StaticResource Text}" StrokeThickness="1.6" Width="11" Height="11" Stretch="Uniform" />
                    </Button>
                    <TextBlock Text="CHI TIẾT" Style="{StaticResource Overline}" VerticalAlignment="Center" />
                </DockPanel>

                <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="InspectorBody" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
