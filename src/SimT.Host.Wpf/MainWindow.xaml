<Window x:Class="SimT.Host.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:local="clr-namespace:SimT.Host.Wpf"
    Title="SimT" Height="800" Width="1320"
        MinHeight="660" MinWidth="1120"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- Typed DataTemplate for intelligent cell rendering (badges, durability meters, monospace numbers) -->
        <DataTemplate DataType="{x:Type local:CellVm}">
            <Grid Margin="2,1">
                <!-- Case 1: Progress / Gauge Meter (Durability or Level) -->
                <Grid Visibility="{Binding ProgressVisibility}" Width="110" HorizontalAlignment="Left">
                    <ProgressBar Height="14" Minimum="0" Maximum="{Binding ProgressMax, Mode=OneWay}" Value="{Binding ProgressValue, Mode=OneWay}"
                                 Foreground="{Binding ProgressBrush}" Background="#1C2430"
                                 BorderBrush="#26303D" BorderThickness="1" />
                    <TextBlock Text="{Binding Text}" FontSize="10" FontWeight="SemiBold"
                               Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <!-- Case 2: Badge Pill -->
                <Border Visibility="{Binding BadgeVisibility}"
                        Background="{Binding BadgeBackground}"
                        BorderBrush="{Binding BadgeBorder}"
                        BorderThickness="1" CornerRadius="4" Padding="6,2"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Text}"
                               Foreground="{Binding BadgeForeground}"
                               FontSize="11" FontWeight="SemiBold" />
                </Border>

                <!-- Case 3: Standard Text / Monospace Numeric -->
                <TextBlock Visibility="{Binding NormalTextVisibility}"
                           Text="{Binding Text}"
                           TextAlignment="{Binding TextAlignment}"
                           FontFamily="{Binding FontFamily}"
                           Foreground="{Binding TextForeground}"
                           VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
        <!-- Row chips come from the screen model, so the host never hard-codes a verb. -->
        <DataTemplate x:Key="ActionsCell">
            <ItemsControl ItemsSource="{Binding Chips}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{Binding Style}"
                                Content="{Binding Label}"
                                Tag="{Binding Id}"
                                Click="RowCommand_Click" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
        <DataTemplate x:Key="DetailCell">
            <Button Content="⋯" Style="{StaticResource ChipButton}" Click="OpenDetail_Click"
                    ToolTip="Xem chi tiết dòng này (double-click hoặc Enter)" />
        </DataTemplate>

        <DataTemplate x:Key="AlertRow">
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,6">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="3" CornerRadius="2"
                            Background="{Binding Accent}" Margin="0,1,10,1" />
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                               Style="{StaticResource Caption}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Rail: who you are, when it is, what you own, where you can go ===== -->
        <Border Grid.Column="0" Background="{StaticResource Rail}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <Grid Margin="16,16,14,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="SIMT" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource Accent}" />
                    <TextBlock x:Name="CampaignText" Style="{StaticResource Caption}" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Border Grid.Row="1" Margin="0,12,0,0" Padding="11,10"
                        Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Overline}" Text="NIÊN ĐẠI" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock x:Name="YearText" Style="{StaticResource Display}" />
                            <TextBlock x:Name="YearSuffixText" Style="{StaticResource Caption}"
                                       VerticalAlignment="Bottom" Margin="6,0,0,6" />
                        </StackPanel>
                        <TextBlock x:Name="SeasonText" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="DateText" Style="{StaticResource Caption}"
                                   Foreground="{StaticResource Faint}" Margin="0,1,0,0" />
                        <TextBlock x:Name="TurnText" Style="{StaticResource Caption}"
                                   Foreground="{StaticResource Faint}" Margin="0,1,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Margin="0,8,0,0" Padding="11,9"
                        Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="8"
                        Cursor="Hand" MouseLeftButtonDown="PlayerCard_Click"
                        ToolTip="Bấm để xem toàn bộ hồ sơ 12 thuộc tính nhân vật chính (Modal)">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="Hồ Sơ 👤" Style="{StaticResource Caption}"
                                       Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource Overline}" Text="NHÂN VẬT" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock x:Name="PlayerNameText" Style="{StaticResource H1}" FontSize="15" Margin="0,2,0,0" />
                        <TextBlock x:Name="PlayerLocationText" Style="{StaticResource Caption}"
                                   Foreground="{StaticResource Accent}" Margin="0,1,0,0" />
                        <DockPanel Margin="0,6,0,0">
                            <TextBlock DockPanel.Dock="Right" x:Name="StaminaText" Style="{StaticResource Caption}"
                                       FontSize="10.5" Foreground="{StaticResource Gain}" />
                            <TextBlock Text="Thể lực" Style="{StaticResource Caption}" FontSize="10.5"
                                       Foreground="{StaticResource Faint}" />
                        </DockPanel>
                        <Border Height="4" Background="{StaticResource SurfaceAlt}" CornerRadius="2" Margin="0,2,0,0">
                            <Border x:Name="StaminaBar" HorizontalAlignment="Left" Background="{StaticResource Gain}" CornerRadius="2" Width="120" />
                        </Border>
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock DockPanel.Dock="Right" x:Name="HealthText" Style="{StaticResource Caption}"
                                       FontSize="10.5" Foreground="{StaticResource Text}" />
                            <TextBlock Text="Sinh lực" Style="{StaticResource Caption}" FontSize="10.5"
                                       Foreground="{StaticResource Faint}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="3" Margin="0,8,0,0" Padding="11,10"
                        Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Overline}" Text="TÀI SẢN" />
                        <TextBlock x:Name="CashText" Style="{StaticResource NumberLarge}" Margin="0,2,0,0" />
                        <TextBlock x:Name="CashHintText" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        <TextBlock x:Name="GoodsText" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        <TextBlock x:Name="NetWorthText" Style="{StaticResource Caption}"
                                   Foreground="{StaticResource Muted}" Margin="0,1,0,0" />
                    </StackPanel>
                </Border>

                <ListBox x:Name="NavList" Grid.Row="4" Margin="0,10,0,0"
                         ItemContainerStyle="{StaticResource NavItem}"
                         SelectionChanged="Nav_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Glyph}" Width="20"
                                           Foreground="{StaticResource Accent}" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" />
                                <Border Grid.Column="2" Background="{StaticResource AccentSoft}"
                                        CornerRadius="9" Padding="6,1" Visibility="{Binding BadgeVisibility}">
                                    <TextBlock Text="{Binding Badge}" FontSize="10"
                                               Foreground="{StaticResource Accent}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="5" Margin="0,10,0,0">
                    <Button Content="Ngày tiếp  ▸" Click="Advance_Click"
                            Style="{StaticResource PrimaryButton}" HorizontalContentAlignment="Center" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Nghỉ ngơi 💤" Click="Rest_Click"
                                Style="{StaticResource GhostButton}" HorizontalContentAlignment="Center"
                                ToolTip="Nghỉ ngơi tĩnh dưỡng 1 ngày (hồi phục thể lực và giảm mệt mỏi)" />
                        <Button Grid.Column="2" Content="Tuần +7" Click="AdvanceWeek_Click"
                                Style="{StaticResource GhostButton}" HorizontalContentAlignment="Center" />
                    </Grid>
                    <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" Margin="0,10,0,0"
                               Foreground="{StaticResource Faint}" FontSize="10.5" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Page ===== -->
        <Grid Grid.Column="1" Margin="26,20,26,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Width="220" Margin="16,0,0,0" VerticalAlignment="Top">
                    <TextBlock Text="LỌC DÒNG" Style="{StaticResource Overline}" Margin="0,0,0,4" />
                    <Grid>
                        <TextBox x:Name="FilterBox" Visibility="Collapsed"
                                 ToolTip="Gõ để lọc các dòng của màn này (Ctrl+F)"
                                 TextChanged="Filter_TextChanged" />
                        <TextBlock x:Name="FilterHint" Text="tên vật phẩm, thành, trạng thái…"
                                   Foreground="{StaticResource Faint}" FontSize="11.5"
                                   Margin="10,0,0,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False" Visibility="Collapsed" />
                    </Grid>
                </StackPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock x:Name="ScreenTitle" Style="{StaticResource H1}" />
                    <TextBlock x:Name="ScreenStatus" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <StackPanel Grid.Row="1" Margin="0,14,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" x:Name="MonthLabel" Style="{StaticResource Caption}"
                               Foreground="{StaticResource Faint}" VerticalAlignment="Bottom" />
                    <TextBlock Text="THÁNG NÀY" Style="{StaticResource Overline}" VerticalAlignment="Bottom" />
                </DockPanel>
                <ItemsControl x:Name="CalendarStrip" Margin="0,6,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Background}" CornerRadius="3" Height="26"
                                    Margin="0,0,3,0" ToolTip="{Binding Tip}">
                                <TextBlock Text="{Binding Label}" FontSize="10"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <WrapPanel x:Name="KpiStrip" Grid.Row="2" Margin="0,12,0,0" />

            <ItemsControl x:Name="AlertFeed" Grid.Row="3" Margin="0,4,0,0"
                          ItemTemplate="{StaticResource AlertRow}" />

            <StackPanel x:Name="GlobalCommands" Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0" />

            <ScrollViewer Grid.Row="5" Margin="0,14,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ContentPanel" />
            </ScrollViewer>

            <Border Grid.Row="6" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="6" Padding="12,9" Margin="0,12,0,0">
                <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" Text="Sẵn sàng." />
            </Border>
        </Grid>

        <!-- ===== Inspector: overlays the page so opening it never reflows the grid ===== -->
        <Border x:Name="InspectorScrim" Grid.Column="1" Panel.ZIndex="19" Visibility="Collapsed"
                Background="#66000000" MouseLeftButtonDown="Scrim_Click" />

        <Border x:Name="InspectorPanel" Grid.Column="1" Panel.ZIndex="20" Width="360"
                HorizontalAlignment="Right" Visibility="Collapsed"
                Background="{StaticResource Rail}" BorderBrush="{StaticResource Line}"
                BorderThickness="1,0,0,0">
            <Grid Margin="18,20,18,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <Button DockPanel.Dock="Right" Content="✕" Click="CloseInspector_Click"
                            Style="{StaticResource GhostButton}" Padding="8,2" FontSize="11" />
                    <TextBlock Text="CHI TIẾT" Style="{StaticResource Overline}" VerticalAlignment="Center" />
                </DockPanel>

                <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="InspectorBody" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
