<Window x:Class="SimT.Host.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SimT" Height="740" Width="1140"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- Row-level buttons come from the screen model, so the host never hard-codes a verb. -->
        <DataTemplate x:Key="ActionsCell">
            <ItemsControl ItemsSource="{Binding Commands}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource ChipButton}"
                                Content="{Binding Label}"
                                Tag="{Binding Id}"
                                Click="RowCommand_Click" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Margin="0,0,18,0" HorizontalAlignment="Right">
                    <TextBlock Style="{StaticResource Caption}" Text="Ngày" HorizontalAlignment="Right" />
                    <TextBlock x:Name="DateText" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Right" />
                </StackPanel>
                <StackPanel Margin="0,0,18,0" HorizontalAlignment="Right">
                    <TextBlock Style="{StaticResource Caption}" Text="Quan" HorizontalAlignment="Right" />
                    <TextBlock x:Name="BalanceText" FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentPure}" HorizontalAlignment="Right" />
                </StackPanel>
                <Button Content="Ngày tiếp  ▸" Click="Advance_Click" Style="{StaticResource AccentButton}"
                        VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="CampaignText" FontSize="19" FontWeight="Bold" />
                <TextBlock x:Name="CityText" Style="{StaticResource Caption}" Margin="0,3,0,0" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Height="1" Background="{StaticResource Line}" Margin="0,14,0,6" />

        <TabControl x:Name="Tabs" Grid.Row="2" SelectionChanged="Tabs_SelectionChanged" />

        <Border Grid.Row="3" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" Text="Sẵn sàng." />
        </Border>
    </Grid>
</Window>
