<local:HubModalWindowBase x:Class="SimT.Host.Wpf.BanditBattleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SimT.Host.Wpf"
        xmlns:controls="clr-namespace:SimT.Host.Wpf.Controls"
        Title="Tiễu Phạt Sơn Trại · Chiến Trận Công Phá &amp; Quyết Chiến Thảo Khấu"
        Height="720" Width="1020"
        MinHeight="640" MinWidth="880"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="260" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Ambient Battle Embers Canvas -->
        <controls:GameAmbientParticlesControl Grid.RowSpan="4" Kind="BattleEmbers" Opacity="0.5" IsHitTestVisible="False" />

        <!-- ================= ROW 0: TOP MATCHUP BANNER ================= -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceAlt}"
                BorderBrush="{StaticResource Line}" BorderThickness="1"
                CornerRadius="8" Padding="16,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Title -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="CHIẾN DỊCH TIỄU PHẠT · CÔNG PHÁ SÀO HUYỆT"
                               Style="{StaticResource Overline}" Foreground="{StaticResource Accent}" />
                    <TextBlock x:Name="StrongholdTitle" Text="Mang Sơn Sào Huyệt"
                               Style="{StaticResource H1}" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Center: Troop Affinity Matchup Badge -->
                <Border Grid.Column="1" x:Name="MatchupBadgeBorder"
                        Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource Accent}" BorderThickness="1"
                        CornerRadius="6" Padding="14,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="MatchupIcon" Text="⚔️" FontSize="15" Margin="0,0,8,0" />
                        <TextBlock x:Name="MatchupSummaryText"
                                   Text="Kỵ Binh khắc Bộ Binh · Bộ Binh khắc Cung Binh · Cung Binh khắc Kỵ Binh"
                                   FontWeight="SemiBold" Foreground="{StaticResource Text}" FontSize="12.5" />
                    </StackPanel>
                </Border>

                <!-- Right: Round Counter & Status -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="RoundCounterText" Text="CHUẨN BỊ XUẤT QUÂN"
                               Style="{StaticResource NumberLarge}" HorizontalAlignment="Right" />
                    <TextBlock x:Name="ExpeditionStatusText" Text="Đang bố trí thế trận..."
                               Style="{StaticResource Caption}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= ROW 1: COMBAT STAGE (TWO ARMIES) ================= -->
        <Border Grid.Row="1" x:Name="CombatStageBorder" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Line}" BorderThickness="1"
                CornerRadius="8" Padding="18,14" Margin="0,0,0,12"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TranslateTransform x:Name="StageShakeTransform" X="0" Y="0" />
            </Border.RenderTransform>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>

                <!-- Floating Combat Damage & Skills VFX Canvas -->
                <Canvas x:Name="CombatVfxCanvas" Grid.ColumnSpan="3" Panel.ZIndex="50" IsHitTestVisible="False" ClipToBounds="True" />

                <!-- ===== LEFT: PLAYER FORCES ===== -->
                <Border Grid.Column="0" Background="{StaticResource SurfaceAlt}"
                        BorderBrush="{StaticResource Line}" BorderThickness="1"
                        CornerRadius="8" Padding="14,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Profile Header -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="52" Height="52"
                                    x:Name="PlayerAvatarBox"
                                    Background="{StaticResource Bg}"
                                    BorderBrush="{StaticResource Gain}" BorderThickness="2"
                                    CornerRadius="6" Margin="0,0,12,0"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="PlayerAvatarTransform" X="0" Y="0" />
                                </Border.RenderTransform>
                                <TextBlock Text="俠" FontSize="28" FontWeight="Bold"
                                           Foreground="{StaticResource Gain}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="PlayerNameText" Text="Lữ Khách"
                                           FontSize="16" FontWeight="Bold" Foreground="{StaticResource Text}" />
                                <TextBlock x:Name="PlayerRoleText" Text="Thống Lĩnh Nghĩa Binh"
                                           Style="{StaticResource Caption}" Foreground="{StaticResource Muted}" />
                                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                                        BorderThickness="1" CornerRadius="3" Padding="6,1" Margin="0,4,0,0"
                                        HorizontalAlignment="Left">
                                    <TextBlock x:Name="PlayerBranchBadge" Text="🐎 Kỵ Binh"
                                               FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Troop Strength Gauge with Ghosting Bar -->
                        <StackPanel Grid.Row="1" Margin="0,12,0,8">
                            <DockPanel Margin="0,0,0,3">
                                <TextBlock Text="👥 Quân Lực Xuất Trận" Style="{StaticResource Caption}" Foreground="{StaticResource Muted}" />
                                <TextBlock x:Name="PlayerTroopValueText" Text="2,140 / 2,140"
                                           FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource Gain}"
                                           HorizontalAlignment="Right" />
                            </DockPanel>
                            <Grid Height="10">
                                <ProgressBar x:Name="PlayerTroopGhostBar" Height="10" Minimum="0" Maximum="2140" Value="2140"
                                             Foreground="{StaticResource Loss}" Background="{StaticResource Surface}" />
                                <ProgressBar x:Name="PlayerTroopBar" Height="10" Minimum="0" Maximum="2140" Value="2140"
                                             Foreground="{StaticResource Gain}" Background="Transparent" />
                            </Grid>
                        </StackPanel>

                        <!-- Commander HP Gauge -->
                        <StackPanel Grid.Row="2" Margin="0,0,0,8">
                            <DockPanel Margin="0,0,0,3">
                                <TextBlock Text="❤️ Khí Huyết Tướng Quân" Style="{StaticResource Caption}" Foreground="{StaticResource Muted}" />
                                <TextBlock x:Name="PlayerHpValueText" Text="130 / 130"
                                           FontWeight="Bold" FontSize="11" Foreground="{StaticResource Text}"
                                           HorizontalAlignment="Right" />
                            </DockPanel>
                            <ProgressBar x:Name="PlayerHpBar" Height="7" Minimum="0" Maximum="130" Value="130"
                                         Foreground="{StaticResource Accent}" Background="{StaticResource Surface}" />
                        </StackPanel>

                        <!-- Skill Callout -->
                        <Border Grid.Row="3" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" CornerRadius="6" Padding="8,6" VerticalAlignment="Bottom">
                            <TextBlock x:Name="PlayerSkillCalloutText"
                                       Text="⚡ Kỹ Năng: Võ Đạo Tinh Thông sẵn sàng kích hoạt"
                                       FontSize="10.5" Foreground="{StaticResource Accent}" TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                </Border>

                <!-- ===== CENTER: CLASH VISUAL ARENA ===== -->
                <Grid Grid.Column="1" Margin="14,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource SurfaceAlt}"
                            BorderBrush="{StaticResource Line}" BorderThickness="1"
                            CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="ClashGlyphText" Text="⚔️" FontSize="26" HorizontalAlignment="Center" />
                            <TextBlock x:Name="ClashPhaseTitle" Text="GIÁP CHIẾN CÔNG ĐỒN"
                                       FontWeight="Bold" FontSize="12" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Background="{StaticResource Rail}"
                            BorderBrush="{StaticResource Line}" BorderThickness="1"
                            CornerRadius="8" Padding="10">
                        <ScrollViewer x:Name="CombatFeedScroll" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="CombatFeedStack">
                                <TextBlock Text="📜 NHẬT KÝ CHIẾN TRƯỜNG" Style="{StaticResource Overline}" Margin="0,0,0,6" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ===== RIGHT: BANDIT CHIEF & OUTLAW HORDE ===== -->
                <Border Grid.Column="2" Background="{StaticResource SurfaceAlt}"
                        BorderBrush="{StaticResource Line}" BorderThickness="1"
                        CornerRadius="8" Padding="14,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Chief Profile Header -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock x:Name="ChiefNameText" Text="Trương Yến"
                                           FontSize="16" FontWeight="Bold" Foreground="{StaticResource Text}"
                                           HorizontalAlignment="Right" />
                                <TextBlock x:Name="ChiefRoleText" Text="Hắc Sơn Kiếp Soái"
                                           Style="{StaticResource Caption}" Foreground="{StaticResource Muted}"
                                           HorizontalAlignment="Right" />
                                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                                        BorderThickness="1" CornerRadius="3" Padding="6,1" Margin="0,4,0,0"
                                        HorizontalAlignment="Right">
                                    <TextBlock x:Name="ChiefBranchBadge" Text="🛡️ Bộ Binh"
                                               FontSize="11" FontWeight="Bold" Foreground="{StaticResource Loss}" />
                                </Border>
                            </StackPanel>

                            <Border Grid.Column="1" Width="52" Height="52"
                                    x:Name="ChiefAvatarBox"
                                    Background="{StaticResource Bg}"
                                    BorderBrush="{StaticResource Loss}" BorderThickness="2"
                                    CornerRadius="6" Margin="12,0,0,0"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ChiefAvatarTransform" X="0" Y="0" />
                                </Border.RenderTransform>
                                <TextBlock x:Name="ChiefAvatarText" Text="賊" FontSize="28" FontWeight="Bold"
                                           Foreground="{StaticResource Loss}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>

                        <!-- Bandit Troop Strength Gauge with Ghosting Bar -->
                        <StackPanel Grid.Row="1" Margin="0,12,0,8">
                            <DockPanel Margin="0,0,0,3">
                                <TextBlock Text="👥 Quân Lực Thảo Khấu" Style="{StaticResource Caption}" Foreground="{StaticResource Muted}" />
                                <TextBlock x:Name="BanditTroopValueText" Text="2,400 / 2,400"
                                           FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource Loss}"
                                           HorizontalAlignment="Right" />
                            </DockPanel>
                            <Grid Height="10">
                                <ProgressBar x:Name="BanditTroopGhostBar" Height="10" Minimum="0" Maximum="2400" Value="2400"
                                             Foreground="{StaticResource Loss}" Background="{StaticResource Surface}" />
                                <ProgressBar x:Name="BanditTroopBar" Height="10" Minimum="0" Maximum="2400" Value="2400"
                                             Foreground="{StaticResource Accent}" Background="Transparent" />
                            </Grid>
                        </StackPanel>

                        <!-- Chief HP Gauge -->
                        <StackPanel Grid.Row="2" Margin="0,0,0,8">
                            <DockPanel Margin="0,0,0,3">
                                <TextBlock Text="❤️ Khí Huyết Sơn Trại Chủ" Style="{StaticResource Caption}" Foreground="{StaticResource Muted}" />
                                <TextBlock x:Name="ChiefHpValueText" Text="150 / 150"
                                           FontWeight="Bold" FontSize="11" Foreground="{StaticResource Loss}"
                                           HorizontalAlignment="Right" />
                            </DockPanel>
                            <ProgressBar x:Name="ChiefHpBar" Height="7" Minimum="0" Maximum="150" Value="150"
                                         Foreground="{StaticResource Loss}" Background="{StaticResource Surface}" />
                        </StackPanel>

                        <!-- Chief Skill Callout -->
                        <Border Grid.Row="3" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" CornerRadius="6" Padding="8,6" VerticalAlignment="Bottom">
                            <TextBlock x:Name="ChiefSkillCalloutText"
                                       Text="💀 Trận Pháp: Sơn Đạo Phục Kích gia tăng sát thương cung tiễn"
                                       FontSize="10.5" Foreground="{StaticResource Loss}" TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ================= ROW 2: ROUND DETAIL NARRATIVE & LOG ================= -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceAlt}"
                BorderBrush="{StaticResource Line}" BorderThickness="1"
                CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="DIỄN BIẾN CHIẾN TRẬN &amp; SỰ VỤ QUÂN CƠ"
                           Style="{StaticResource Overline}" Foreground="{StaticResource Accent}" Margin="0,0,0,6" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="NarrativeDisplayText"
                               Text="Hai bên dàn trận sẵn sàng. Trống trận vang dội góc trời..."
                               FontSize="13" LineHeight="20" Foreground="{StaticResource Text}"
                               TextWrapping="Wrap" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ================= ROW 3: COMMAND ACTIONS & SUMMARY ================= -->
        <Border Grid.Row="3" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Line}" BorderThickness="1"
                CornerRadius="8" Padding="14,10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="BottomStatusText"
                               Text="Hãy chỉ huy quân đội từng hiệp hoặc giải quyết nhanh toàn cục."
                               Style="{StaticResource Caption}" Foreground="{StaticResource Muted}" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="NextRoundBtn" Content="Hiệp Kế Tiếp ⚔️"
                            Style="{StaticResource PrimaryButton}"
                            FontWeight="Bold" Padding="16,8" Margin="0,0,8,0"
                            Click="NextRound_Click" />
                    <Button x:Name="AutoResolveBtn" Content="Đánh Nhanh Hết Trận ⚡"
                            Style="{StaticResource GhostButton}"
                            Padding="14,8" Margin="0,0,8,0"
                            Click="AutoResolve_Click" />
                    <Button x:Name="CloseBtn" Content="Rút Lui"
                            Style="{StaticResource GhostButton}"
                            Padding="14,8"
                            Click="Close_Click" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</local:HubModalWindowBase>
