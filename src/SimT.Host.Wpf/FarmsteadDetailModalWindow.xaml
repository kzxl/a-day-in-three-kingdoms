<local:HubModalWindowBase x:Class="SimT.Host.Wpf.FarmsteadDetailModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SimT.Host.Wpf"
        xmlns:controls="clr-namespace:SimT.Host.Wpf.Controls"
        Title="Điền Trang Nông Vụ · Chi Tiết Thửa Ruộng &amp; Mùa Vụ Canh Tác"
        Height="720" Width="920"
        MinHeight="620" MinWidth="820"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= ROW 0: GAME HUB HEADER ================= -->
        <controls:GameHubHeader Grid.Row="0" x:Name="HubHeader" />

        <!-- ================= ROW 1: PLOT DOSSIER ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== LEFT COLUMN: SOIL FERTILITY, IRRIGATION & FACILITIES ===== -->
            <Border Grid.Column="0" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="8" Padding="16,14" Margin="0,0,12,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="THỔ NHƯỠNG &amp; THỦY LỢI NÔNG ĐIỀN"
                                   Style="{StaticResource Overline}" Foreground="{StaticResource Gain}" Margin="0,0,0,10" />

                        <!-- Plot Status Banner -->
                        <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="60" Height="60"
                                        Background="{StaticResource Bg}"
                                        BorderBrush="{StaticResource Gain}" BorderThickness="2"
                                        CornerRadius="8" Margin="0,0,12,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="田" FontSize="30" FontWeight="Bold"
                                               Foreground="{StaticResource Gain}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="PlotHeadingText" Text="Thửa Ruộng Màu Mỡ"
                                               FontSize="16" FontWeight="Bold" Foreground="{StaticResource Text}" />
                                    <TextBlock x:Name="PlotTenancyText" Text="Trạng thái: Đã thuê canh tác"
                                               Style="{StaticResource Caption}" Foreground="{StaticResource Gain}" Margin="0,2,0,2" />
                                    <TextBlock x:Name="PlotLocationText" Text="Vị trí: Ngoại Ô Lạc Dương"
                                               Style="{StaticResource Caption}" Foreground="{StaticResource Muted}" />
                                    <TextBlock x:Name="WeatherResonanceText" Text="Tiết khí: Cốc Vũ · Nắng ráo"
                                               Style="{StaticResource Caption}" Foreground="{StaticResource Accent}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Soil & Irrigation Metrics -->
                        <UniformGrid Columns="2" Margin="0,0,0,12">
                            <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                                    BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,4,6">
                                <StackPanel>
                                    <TextBlock Text="🌱 ĐỘ PHÌ NHIÊU" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Gain}" />
                                    <TextBlock x:Name="SoilFertilityText" Text="85 / 100" Style="{StaticResource NumberLarge}" Foreground="{StaticResource Gain}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                                    BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="4,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="💧 THỦY LỢI TƯỚI TIÊU" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                                    <TextBlock x:Name="IrrigationLevelText" Text="Cấp 2 / 3" Style="{StaticResource NumberLarge}" Foreground="{StaticResource Accent}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                                    BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,4,4,0">
                                <StackPanel>
                                    <TextBlock Text="📐 DIỆN TÍCH" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                                    <TextBlock x:Name="PlotAreaText" Text="15 Mẫu" Style="{StaticResource NumberLarge}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                                    BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="4,4,0,0">
                                <StackPanel>
                                    <TextBlock Text="💰 TIỀN THUÊ" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                                    <TextBlock x:Name="MonthlyRentText" Text="30 Quan/tháng" Style="{StaticResource NumberLarge}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Facilities at Estate -->
                        <TextBlock Text="Hạ Tầng Nông Trang Tại Châu Quận" Style="{StaticResource Caption}"
                                   Foreground="{StaticResource Muted}" Margin="0,0,0,4" />
                        <ItemsControl x:Name="FacilitiesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                                            BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,4">
                                        <DockPanel>
                                            <TextBlock Text="🏗️" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding NameVi}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource Text}" />
                                                <TextBlock Text="{Binding EffectVi}" Style="{StaticResource Caption}" Foreground="{StaticResource Muted}" />
                                            </StackPanel>
                                            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                                                    BorderThickness="1" CornerRadius="3" Padding="6,2"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TierTitleVi}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                                            </Border>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ===== RIGHT COLUMN: CROP PROGRESSION & FARM OPERATIONS ===== -->
            <Border Grid.Column="1" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="8" Padding="18,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Hardware-accelerated Visual Crop Growth Cycle & Soil Arc Gauge -->
                            <controls:GameCropGrowthVisualizer x:Name="CropGrowthVisualizer" Margin="0,0,0,16" />

                            <!-- Crop Progress Card -->
                            <TextBlock Text="🌾 GIAI ĐOẠN SINH TRƯỞNG &amp; MÙA VỤ"
                                       Style="{StaticResource Overline}" Foreground="{StaticResource Gain}" Margin="0,0,0,8" />

                            <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                                    BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock x:Name="CropNameText" Text="Lúa Nước Vụ Mùa" FontWeight="Bold" FontSize="16" Foreground="{StaticResource Text}" />
                                        <Border x:Name="CropStatusBadge" Background="{StaticResource AccentSoft}"
                                                BorderBrush="{StaticResource Line}" BorderThickness="1"
                                                CornerRadius="3" Padding="8,2" HorizontalAlignment="Right">
                                            <TextBlock x:Name="CropStatusBadgeText" Text="Đang Sinh Trưởng" FontWeight="Bold" FontSize="11" Foreground="{StaticResource Accent}" />
                                        </Border>
                                    </DockPanel>

                                    <ProgressBar x:Name="CropProgressBar" Height="10" Minimum="0" Maximum="100" Value="65"
                                                 Foreground="{StaticResource Gain}" Background="{StaticResource Surface}" Margin="0,4,0,8" />

                                    <DockPanel>
                                        <TextBlock x:Name="HarvestDaysText" Text="⏳ Dự kiến thu hoạch sau: 12 ngày" Style="{StaticResource Caption}" Foreground="{StaticResource Muted}" />
                                        <TextBlock x:Name="EstimatedYieldText" Text="Sản lượng: ~35 Thạch Gạo" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource Gain}" HorizontalAlignment="Right" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <!-- Farming Supplies & Tools -->
                            <TextBlock Text="🧺 VẬT TƯ &amp; NÔNG CỤ TRONG KHO"
                                       Style="{StaticResource Overline}" Margin="0,0,0,8" />

                            <Border Background="{StaticResource Rail}" BorderBrush="{StaticResource Line}"
                                    BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,16">
                                <UniformGrid Columns="2">
                                    <TextBlock x:Name="SeedsStockText" Text="🌾 Hạt giống lúa: 5 túi" FontSize="11.5" Foreground="{StaticResource Text}" Margin="0,2" />
                                    <TextBlock x:Name="FertilizerStockText" Text="🌱 Phân hữu cơ: 8 bao" FontSize="11.5" Foreground="{StaticResource Text}" Margin="0,2" />
                                    <TextBlock x:Name="ToolsStockText" Text="⚒ Nông cụ: Cuốc, Liềm đầy đủ" FontSize="11.5" Foreground="{StaticResource Text}" Margin="0,2" />
                                    <TextBlock x:Name="WaterScoopStockText" Text="💧 Gầu tát nước: Có sẵn" FontSize="11.5" Foreground="{StaticResource Text}" Margin="0,2" />
                                </UniformGrid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom Action Strip -->
                    <Border Grid.Row="1" Background="{StaticResource SurfaceAlt}"
                            BorderBrush="{StaticResource Line}" BorderThickness="1"
                            CornerRadius="8" Padding="12,10" Margin="0,12,0,0">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                <TextBlock x:Name="FarmHintText" Text="Chăm sóc đúng mùa vụ giúp gia tăng sản lượng thu hoạch"
                                           Style="{StaticResource Caption}" Foreground="{StaticResource Muted}" />
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="IrrigateBtn" Content="💧 Tưới Nước"
                                        Style="{StaticResource GhostButton}"
                                        Padding="14,8" Margin="0,0,6,0"
                                        Click="Irrigate_Click" />
                                <Button x:Name="FertilizeBtn" Content="🌱 Bón Phân"
                                        Style="{StaticResource GhostButton}"
                                        Padding="14,8" Margin="0,0,6,0"
                                        Click="Fertilize_Click" />
                                <Button x:Name="HarvestBtn" Content="🧺 Thu Hoạch"
                                        Style="{StaticResource PrimaryButton}"
                                        FontWeight="Bold" Padding="16,8" Margin="0,0,8,0"
                                        Click="Harvest_Click" />
                                <Button Content="Trở Về"
                                        Style="{StaticResource GhostButton}"
                                        Padding="16,8"
                                        Click="Close_Click" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</local:HubModalWindowBase>
