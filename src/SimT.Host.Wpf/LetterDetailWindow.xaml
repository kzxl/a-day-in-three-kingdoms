<Window x:Class="SimT.Host.Wpf.LetterDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thư Tín Tri Kỷ"
        Width="680" Height="560"
        MinWidth="500" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}">

    <Border Padding="24" Background="{StaticResource Bg}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Header with title & sender metadata -->
            <Border Grid.Row="0"
                    Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Line}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,14"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="✉️"
                               FontSize="32"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText"
                                   Text="Tiêu Đề Phong Thư"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Accent}"
                                   TextWrapping="Wrap" />

                        <DockPanel Margin="0,6,0,0">
                            <TextBlock x:Name="SenderText"
                                       Text="Người gửi: ..."
                                       FontSize="13"
                                       Foreground="{StaticResource Text}" />
                            <TextBlock x:Name="DateText"
                                       Text="Ngày gửi: ..."
                                       FontSize="13"
                                       Foreground="{StaticResource Faint}"
                                       TextAlignment="Right"
                                       DockPanel.Dock="Right" />
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Scrollable letter body -->
            <Border Grid.Row="1"
                    Background="{StaticResource SurfaceAlt}"
                    BorderBrush="{StaticResource Line}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18,16"
                    Margin="0,0,0,16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="ContentText"
                               Text="Nội dung thư..."
                               FontSize="14"
                               LineHeight="22"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource Text}" />
                </ScrollViewer>
            </Border>

            <!-- 3. Attached Gift Section -->
            <Border x:Name="GiftBorder"
                    Grid.Row="2"
                    Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Accent}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,12"
                    Margin="0,0,0,16"
                    Visibility="Collapsed">
                <DockPanel LastChildFill="True">
                    <Button x:Name="ClaimGiftBtn"
                            DockPanel.Dock="Right"
                            Content="Nhận Quà 🎁"
                            Style="{StaticResource PrimaryButton}"
                            Padding="16,8"
                            Margin="12,0,0,0"
                            Click="ClaimGift_Click" />

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="LỄ VẬT ĐÍNH KÈM"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Faint}" />
                        <TextBlock x:Name="GiftSummaryText"
                                   Text="🎁 150 Quan tiền"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Accent}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 4. Footer controls -->
            <DockPanel Grid.Row="3">
                <TextBlock x:Name="StatusNoticeText"
                           Text=""
                           FontSize="12"
                           Foreground="{StaticResource Accent}"
                           VerticalAlignment="Center" />

                <Button DockPanel.Dock="Right"
                        Content="Đóng"
                        Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Right"
                        Padding="24,8"
                        Click="Close_Click" />
            </DockPanel>
        </Grid>
    </Border>
</Window>
