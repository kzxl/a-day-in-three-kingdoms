<local:HubModalWindowBase x:Class="SimT.Host.Wpf.CitadelDetailModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SimT.Host.Wpf"
        xmlns:controls="clr-namespace:SimT.Host.Wpf.Controls"
        Title="Châu Quận Toàn Thư · Chi Tiết Thành Trì &amp; Phong Thổ Dân Tình"
        Height="720" Width="920"
        MinHeight="620" MinWidth="820"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= ROW 0: GAME HUB HEADER ================= -->
        <controls:GameHubHeader Grid.Row="0" x:Name="HubHeader" />

        <!-- ================= ROW 1: CITADEL DOSSIER ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== LEFT COLUMN: GOVERNANCE, DEMOGRAPHICS & DEFENSES ===== -->
            <Border Grid.Column="0" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="8" Padding="16,14" Margin="0,0,12,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="QUAN TRỊ NỘI CHÍNH &amp; PHÒNG THỦ"
                                   Style="{StaticResource Overline}" Foreground="{StaticResource Accent}" Margin="0,0,0,10" />

                        <!-- Governor Card -->
                        <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="58" Height="58"
                                        x:Name="GovernorAvatarBox"
                                        Background="{StaticResource Bg}"
                                        BorderBrush="{StaticResource Accent}" BorderThickness="2"
                                        CornerRadius="8" Margin="0,0,12,0"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="GovernorAvatarText" Text="官"
                                               FontSize="28" FontWeight="Bold"
                                               Foreground="{StaticResource Accent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="GovernorTitleText" Text="Thái Thú Đương Nhiệm"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource Accent}" />
                                    <TextBlock x:Name="GovernorNameText" Text="Quan Cai Quản"
                                               FontSize="16" FontWeight="Bold"
                                               Foreground="{StaticResource Text}" Margin="0,1,0,3" />
                                    <TextBlock x:Name="FactionAffiliationText" Text="Thuộc Thế Lực: Triều Đình Hán Thất"
                                               Style="{StaticResource Caption}" Foreground="{StaticResource Muted}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Metrics Grid -->
                        <UniformGrid Columns="2" Margin="0,0,0,12">
                            <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                                    BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,4,6">
                                <StackPanel>
                                    <TextBlock Text="👥 DÂN SỐ" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                                    <TextBlock x:Name="PopulationText" Text="120,000" Style="{StaticResource NumberLarge}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                                    BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="4,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="⚖ TRỊ AN" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Gain}" />
                                    <TextBlock x:Name="PublicOrderText" Text="85%" Style="{StaticResource NumberLarge}" Foreground="{StaticResource Gain}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                                    BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,4,4,0">
                                <StackPanel>
                                    <TextBlock Text="🏰 PHÒNG THỦ" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                                    <TextBlock x:Name="DefenseText" Text="Cấp 8" Style="{StaticResource NumberLarge}" Foreground="{StaticResource Accent}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                                    BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="4,4,0,0">
                                <StackPanel>
                                    <TextBlock Text="🌾 KHO LƯƠNG" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                                    <TextBlock x:Name="GranaryText" Text="Dồi Dào" Style="{StaticResource NumberLarge}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Local Bandit Threat Callout -->
                        <TextBlock Text="Mối Đe Dọa Thảo Khấu Quanh Vùng" Style="{StaticResource Caption}"
                                   Foreground="{StaticResource Muted}" Margin="0,0,0,4" />
                        <Border x:Name="StrongholdCalloutBorder" Background="{StaticResource Rail}"
                                BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="⛰ Sào Huyệt Ngoại Thành:" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource Text}" />
                                    <TextBlock x:Name="StrongholdCountText" Text="1 Cứ Điểm" FontWeight="Bold"
                                               Foreground="{StaticResource Loss}" HorizontalAlignment="Right" />
                                </DockPanel>
                                <TextBlock x:Name="StrongholdSummaryText"
                                           Text="Mang Sơn Sào Huyệt (Hắc Sơn Quân - Nguy hiểm Cấp 4)"
                                           FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Description & History -->
                        <TextBlock Text="Lịch Sử &amp; Phong Thổ" Style="{StaticResource Caption}"
                                   Foreground="{StaticResource Muted}" Margin="0,0,0,4" />
                        <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" CornerRadius="6" Padding="12,10">
                            <TextBlock x:Name="CitadelBioText"
                                       Text="Kinh đô ngàn năm văn hiến, non sông gấm vóc, trung tâm chính trị của thiên hạ."
                                       FontSize="12" LineHeight="19"
                                       Foreground="{StaticResource Text}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ===== RIGHT COLUMN: RESIDING NPCS & URBAN SUBLOCATIONS ===== -->
            <Border Grid.Column="1" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="8" Padding="18,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Section 1: Residing Celebrities & Warriors -->
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="👥 DANH NHÂN &amp; VÕ TƯỚNG TẠI THÀNH"
                                           Style="{StaticResource Overline}" Foreground="{StaticResource Accent}" />
                                <TextBlock x:Name="NpcCountHeader" Text="5 Nhân vật"
                                           HorizontalAlignment="Right" Style="{StaticResource Caption}" Foreground="{StaticResource Muted}" />
                            </DockPanel>

                            <ItemsControl x:Name="ResidingNpcList" Margin="0,0,0,16">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                                                BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                            <DockPanel>
                                                <Border Width="38" Height="38" Background="{StaticResource Bg}"
                                                        BorderBrush="{StaticResource Accent}" BorderThickness="1"
                                                        CornerRadius="6" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding AvatarChar}" FontSize="18" FontWeight="Bold"
                                                               Foreground="{StaticResource Accent}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>

                                                <StackPanel VerticalAlignment="Center">
                                                    <DockPanel>
                                                        <TextBlock Text="{Binding NameVi}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Text}" />
                                                        <TextBlock Text="{Binding WarText}" FontSize="11" Foreground="{StaticResource Loss}" Margin="8,0,0,0" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Role}" FontSize="11" Foreground="{StaticResource Muted}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Section 2: Urban Sublocations -->
                            <TextBlock Text="🏛️ ĐỊA ĐIỂM NỘI THỊ &amp; DANH THẮNG"
                                       Style="{StaticResource Overline}" Margin="0,0,0,8" />

                            <ItemsControl x:Name="SublocationsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                                                BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,4">
                                            <DockPanel>
                                                <TextBlock Text="{Binding Glyph}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding NameVi}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Text}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding CategoryVi}" HorizontalAlignment="Right" Style="{StaticResource Caption}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Section 3: Bottom Control Action Strip -->
                    <Border Grid.Row="1" Background="{StaticResource SurfaceAlt}"
                            BorderBrush="{StaticResource Line}" BorderThickness="1"
                            CornerRadius="8" Padding="12,10" Margin="0,12,0,0">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                <TextBlock x:Name="LocationPresenceText" Text="📍 Bạn đang có mặt tại thành trì này"
                                           Style="{StaticResource Caption}" Foreground="{StaticResource Gain}" />
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="StrollCityBtn" Content="🏮 Du Ngoạn Phố"
                                        Style="{StaticResource PrimaryButton}"
                                        FontWeight="Bold" Padding="16,8" Margin="0,0,8,0"
                                        Click="StrollCity_Click" />
                                <Button Content="Trở Về"
                                        Style="{StaticResource GhostButton}"
                                        Padding="16,8"
                                        Click="Close_Click" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</local:HubModalWindowBase>
