<Window x:Class="SimT.Host.Wpf.NpcDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hồ Sơ Nhân Sĩ Tam Quốc" Height="730" Width="720"
        MinHeight="600" MinWidth="600"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Header: Avatar, Name, Courtesy, Role, Citadel, Personality ===== -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceAlt}"
                BorderBrush="{StaticResource Line}" BorderThickness="1"
                CornerRadius="8" Padding="16,14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Avatar Seal -->
                <Border Grid.Column="0" Width="74" Height="74"
                        Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource Accent}" BorderThickness="2"
                        CornerRadius="8" Margin="0,0,16,0"
                        VerticalAlignment="Center">
                    <Grid>
                        <TextBlock x:Name="AvatarCharText" Text="武"
                                   FontSize="38" FontWeight="Bold"
                                   Foreground="{StaticResource Accent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Border Background="{StaticResource AccentSoft}" CornerRadius="0,0,6,0"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Padding="4,1">
                            <TextBlock x:Name="RoleBadgeSmall" Text="TƯỚNG" FontSize="9"
                                       Foreground="{StaticResource Accent}" FontWeight="Bold" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Identity Info -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="NameText" Style="{StaticResource Display}" FontSize="22"
                                   Foreground="{StaticResource Text}" VerticalAlignment="Bottom" />
                        <TextBlock x:Name="HanNameText" FontSize="17" FontWeight="Normal"
                                   Foreground="{StaticResource Accent}" Margin="8,0,0,2"
                                   VerticalAlignment="Bottom" />
                        <TextBlock x:Name="StyleNameText" Style="{StaticResource Caption}"
                                   Foreground="{StaticResource Muted}" Margin="8,0,0,3"
                                   VerticalAlignment="Bottom" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" CornerRadius="4" Padding="7,2" Margin="0,0,6,0">
                            <TextBlock x:Name="RoleText" FontSize="11.5" Foreground="{StaticResource Text}" />
                        </Border>
                        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" CornerRadius="4" Padding="7,2" Margin="0,0,6,0">
                            <TextBlock x:Name="CitadelText" FontSize="11.5" Foreground="{StaticResource Accent}" />
                        </Border>
                    </StackPanel>

                    <TextBlock x:Name="PersonalityText" Style="{StaticResource Caption}"
                               Foreground="{StaticResource Faint}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Total Stat Summary -->
                <Border Grid.Column="2" Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource Line}" BorderThickness="1"
                        CornerRadius="6" Padding="12,8" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="TỔNG ĐIỂM" Style="{StaticResource Overline}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="TotalStatsText" Style="{StaticResource NumberLarge}"
                                   HorizontalAlignment="Center" Margin="0,2,0,0" />
                        <TextBlock Text="/ 1200" Style="{StaticResource Caption}"
                                   Foreground="{StaticResource Faint}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===== Body: 8 Core Stats, 4 Innate Stats, and History Bio ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,4,0">

                <!-- Section: Bát Trụ Năng Lực (8 Core Stats) -->
                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="BÁT TRỤ NĂNG LỰC · ACTION CAPACITIES (1 - 120)" Style="{StaticResource Overline}" Margin="0,0,0,10" />

                        <UniformGrid Columns="2" x:Name="CoreStatsGrid">
                            <!-- Populated dynamically in code-behind for clean stat bars and ranking badges -->
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Section: Tứ Trụ Bản Thể & Khí Vận (4 Innate Stats) -->
                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="TỨ TRỤ BẢN THỂ &amp; KHÍ VẬN · INNATE VITALS &amp; DESTINY" Style="{StaticResource Overline}" Margin="0,0,10,0" />

                        <UniformGrid Columns="2" x:Name="InnateStatsGrid" Margin="0,10,0,0">
                            <!-- Populated dynamically in code-behind -->
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Section: Tiểu Sử & Hành Trạng Lịch Sử -->
                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,6">
                    <StackPanel>
                        <TextBlock Text="TIỂU SỬ &amp; HÀNH TRẠNG LỊCH SỬ" Style="{StaticResource Overline}" Margin="0,0,0,8" />
                        <TextBlock x:Name="BioText" Style="{StaticResource Caption}"
                                   Foreground="{StaticResource Text}" TextWrapping="Wrap"
                                   LineHeight="20" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ===== Footer: Close button ===== -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="Phím tắt: [ESC] để đóng cửa sổ" Style="{StaticResource Caption}"
                       Foreground="{StaticResource Faint}" VerticalAlignment="Center" />
            <Button Content="Đóng" HorizontalAlignment="Right" Width="100"
                    Style="{StaticResource PrimaryButton}" Click="Close_Click" />
        </DockPanel>
    </Grid>
</Window>
