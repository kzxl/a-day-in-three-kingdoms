<Window x:Class="SimT.Host.Wpf.DuelBattleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lôi Đài Tỷ Võ · Đơn Đấu Chiến Thuật &amp; Binh Chủng Tương Khắc"
        Height="720" Width="1000"
        MinHeight="620" MinWidth="880"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="260" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= ROW 0: TOP MATCHUP BANNER ================= -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceAlt}"
                BorderBrush="{StaticResource Line}" BorderThickness="1"
                CornerRadius="8" Padding="16,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Title -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="SO TÀI LÔI ĐÀI · ĐƠN ĐẤU CHIẾN THUẬT"
                               Style="{StaticResource Overline}" Foreground="{StaticResource Accent}" />
                    <TextBlock x:Name="CitadelArenaTitle" Text="Diễn Võ Đài Lạc Dương"
                               Style="{StaticResource H1}" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Center: Troop Affinity Matchup Badge -->
                <Border Grid.Column="1" x:Name="MatchupBadgeBorder"
                        Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource Accent}" BorderThickness="1"
                        CornerRadius="6" Padding="14,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="MatchupIcon" Text="⚔️" FontSize="15" Margin="0,0,8,0" />
                        <TextBlock x:Name="MatchupSummaryText"
                                   Text="Kỵ Binh khắc Bộ Binh · Bộ Binh khắc Cung Binh · Cung Binh khắc Kỵ Binh"
                                   FontWeight="SemiBold" Foreground="{StaticResource Text}" FontSize="12.5" />
                    </StackPanel>
                </Border>

                <!-- Right: Round Counter & Status -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="RoundCounterText" Text="HIỆP 1 / 5"
                               Style="{StaticResource NumberLarge}" HorizontalAlignment="Right" />
                    <TextBlock x:Name="DuelStatusText" Text="Đang diễn biến..."
                               Style="{StaticResource Caption}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= ROW 1: COMBAT STAGE (ARENA) ================= -->
        <Border Grid.Row="1" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Line}" BorderThickness="1"
                CornerRadius="8" Padding="18,14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="310" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="310" />
                </Grid.ColumnDefinitions>

                <!-- ===== LEFT: PLAYER / CHALLENGER ===== -->
                <Border Grid.Column="0" Background="{StaticResource SurfaceAlt}"
                        BorderBrush="{StaticResource Line}" BorderThickness="1"
                        CornerRadius="8" Padding="14,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Profile Header -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="52" Height="52"
                                    Background="{StaticResource Bg}"
                                    BorderBrush="{StaticResource Gain}" BorderThickness="2"
                                    CornerRadius="6" Margin="0,0,12,0">
                                <TextBlock Text="俠" FontSize="28" FontWeight="Bold"
                                           Foreground="{StaticResource Gain}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="PlayerNameText" Text="Lữ Khách"
                                               FontWeight="Bold" FontSize="16" Foreground="{StaticResource Text}" />
                                    <Border Background="{StaticResource Gain}" CornerRadius="3"
                                            Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="BẠN" FontSize="9" FontWeight="Bold" Foreground="#0E1116" />
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="PlayerTitleText" Text="Hiệp Khách Hành Giả"
                                           Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- Branch Selection Radios (Interactive before or during start) -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,6">
                            <TextBlock Text="Binh Chủng:" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <RadioButton x:Name="PlayerBranchInfantryRadio" Content="🛡️ Bộ"
                                         GroupName="PlayerBranch" IsChecked="True"
                                         Margin="0,0,6,0" Foreground="{StaticResource Text}"
                                         Checked="PlayerBranchRadio_Checked" />
                            <RadioButton x:Name="PlayerBranchCavalryRadio" Content="🐎 Kỵ"
                                         GroupName="PlayerBranch"
                                         Margin="0,0,6,0" Foreground="{StaticResource Text}"
                                         Checked="PlayerBranchRadio_Checked" />
                            <RadioButton x:Name="PlayerBranchArchersRadio" Content="🏹 Cung"
                                         GroupName="PlayerBranch"
                                         Foreground="{StaticResource Text}"
                                         Checked="PlayerBranchRadio_Checked" />
                        </StackPanel>

                        <!-- Gauges (HP & Spirit) -->
                        <StackPanel Grid.Row="2" Margin="0,6,0,0">
                            <!-- HP Bar -->
                            <Grid Margin="0,0,0,6">
                                <ProgressBar x:Name="PlayerHpBar" Height="18" Minimum="0" Maximum="100" Value="100"
                                             Background="{StaticResource Bg}" Foreground="{StaticResource Gain}"
                                             BorderBrush="{StaticResource Line}" BorderThickness="1" />
                                <TextBlock x:Name="PlayerHpLabel" Text="HP: 100 / 100"
                                           FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>

                            <!-- Spirit / Khí Bar -->
                            <Grid>
                                <ProgressBar x:Name="PlayerSpiritBar" Height="14" Minimum="0" Maximum="100" Value="0"
                                             Background="{StaticResource Bg}" Foreground="#06B6D4"
                                             BorderBrush="{StaticResource Line}" BorderThickness="1" />
                                <TextBlock x:Name="PlayerSpiritLabel" Text="Khí Lực: 0 / 100"
                                           FontSize="10" FontWeight="SemiBold" Foreground="#FFFFFF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>

                        <!-- Action Stance & Floating Damage -->
                        <Grid Grid.Row="3" Margin="0,10,0,0" VerticalAlignment="Bottom">
                            <Border x:Name="PlayerActionBadge"
                                    Background="{StaticResource Surface}"
                                    BorderBrush="{StaticResource Line}" BorderThickness="1"
                                    CornerRadius="6" Padding="10,6" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="PlayerActionIcon" Text="⚔️" FontSize="14" Margin="0,0,6,0" />
                                    <TextBlock x:Name="PlayerActionText" Text="THỦ THẾ" FontWeight="Bold" FontSize="12" />
                                </StackPanel>
                            </Border>

                            <!-- Floating Damage Popup -->
                            <TextBlock x:Name="PlayerDamagePopup" Text=""
                                       FontSize="16" FontWeight="Bold" Foreground="{StaticResource Loss}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- ===== CENTER: CLASH ANIMATION ARENA ===== -->
                <Grid Grid.Column="1" Margin="12,0,12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Banner / Action Clash Heading -->
                    <Border Grid.Row="0" x:Name="ClashBannerBorder"
                            Background="{StaticResource SurfaceAlt}"
                            BorderBrush="{StaticResource Line}" BorderThickness="1"
                            CornerRadius="6" Padding="10,4" HorizontalAlignment="Center">
                        <TextBlock x:Name="ClashBannerText" Text="CHUẨN BỊ GIAO TRANH"
                                   FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                    </Border>

                    <!-- Center Animated Clash Symbol -->
                    <Viewbox Grid.Row="1" Width="100" Height="100" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="ClashSymbolText" Text="⚔️"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <ScaleTransform x:Name="ClashScaleTransform" ScaleX="1.0" ScaleY="1.0" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Viewbox>

                    <!-- Mid Ticker Notice -->
                    <TextBlock Grid.Row="2" x:Name="ClashNoticeText"
                               Text="Nhấn '▶ Tự Động Đấu' hoặc 'Hiệp Kế' để bắt đầu trận tỷ thí"
                               Style="{StaticResource Caption}" HorizontalAlignment="Center"
                               TextAlignment="Center" Margin="0,0,0,4" />
                </Grid>

                <!-- ===== RIGHT: OPPONENT / NPC ===== -->
                <Border Grid.Column="2" Background="{StaticResource SurfaceAlt}"
                        BorderBrush="{StaticResource Line}" BorderThickness="1"
                        CornerRadius="8" Padding="14,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Profile Header -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="52" Height="52"
                                    Background="{StaticResource Bg}"
                                    BorderBrush="{StaticResource Accent}" BorderThickness="2"
                                    CornerRadius="6" Margin="0,0,12,0">
                                <TextBlock x:Name="OpponentAvatarCharText" Text="武" FontSize="28" FontWeight="Bold"
                                           Foreground="{StaticResource Accent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="OpponentNameText" Text="Quan Vũ"
                                               FontWeight="Bold" FontSize="16" Foreground="{StaticResource Text}" />
                                    <Border Background="{StaticResource AccentSoft}" CornerRadius="3"
                                            Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="ĐỐI THỦ" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="OpponentRoleText" Text="Võ Tướng Thục Hán"
                                           Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- Opponent Stats & Branch Info -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,6">
                            <TextBlock x:Name="OpponentBranchBadge" Text="🐎 Kỵ Binh"
                                       FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Accent}"
                                       Margin="0,0,12,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="OpponentWarText" Text="Võ Lực: 98"
                                       Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Gauges (HP & Spirit) -->
                        <StackPanel Grid.Row="2" Margin="0,6,0,0">
                            <!-- HP Bar -->
                            <Grid Margin="0,0,0,6">
                                <ProgressBar x:Name="OpponentHpBar" Height="18" Minimum="0" Maximum="100" Value="100"
                                             Background="{StaticResource Bg}" Foreground="{StaticResource Gain}"
                                             BorderBrush="{StaticResource Line}" BorderThickness="1" />
                                <TextBlock x:Name="OpponentHpLabel" Text="HP: 100 / 100"
                                           FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>

                            <!-- Spirit / Khí Bar -->
                            <Grid>
                                <ProgressBar x:Name="OpponentSpiritBar" Height="14" Minimum="0" Maximum="100" Value="0"
                                             Background="{StaticResource Bg}" Foreground="#06B6D4"
                                             BorderBrush="{StaticResource Line}" BorderThickness="1" />
                                <TextBlock x:Name="OpponentSpiritLabel" Text="Khí Lực: 0 / 100"
                                           FontSize="10" FontWeight="SemiBold" Foreground="#FFFFFF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>

                        <!-- Action Stance & Floating Damage -->
                        <Grid Grid.Row="3" Margin="0,10,0,0" VerticalAlignment="Bottom">
                            <Border x:Name="OpponentActionBadge"
                                    Background="{StaticResource Surface}"
                                    BorderBrush="{StaticResource Line}" BorderThickness="1"
                                    CornerRadius="6" Padding="10,6" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="OpponentActionIcon" Text="⚔️" FontSize="14" Margin="0,0,6,0" />
                                    <TextBlock x:Name="OpponentActionText" Text="THỦ THẾ" FontWeight="Bold" FontSize="12" />
                                </StackPanel>
                            </Border>

                            <!-- Floating Damage Popup -->
                            <TextBlock x:Name="OpponentDamagePopup" Text=""
                                       FontSize="16" FontWeight="Bold" Foreground="{StaticResource Loss}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ================= ROW 2: BATTLE CHRONICLE (NARRATIVE LOG) ================= -->
        <Border Grid.Row="2" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Line}" BorderThickness="1"
                CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="📜 BIÊN NIÊN CHIẾN BÁO LÔI ĐÀI (TAM QUỐC VÕ CHIẾN)"
                           Style="{StaticResource Overline}" Foreground="{StaticResource Muted}" Margin="0,0,0,6" />

                <ScrollViewer Grid.Row="1" x:Name="ChronicleScrollViewer" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ChroniclePanel">
                        <!-- Entries added dynamically -->
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ================= ROW 3: CONTROLS & VICTORY FOOTER ================= -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left Controls: Auto-Play & Speed -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="AutoPlayButton" Content="▶ Tự Động Đấu (Auto-Play)"
                        Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                        Click="AutoPlayButton_Click" />

                <Button x:Name="Speed1xButton" Content="1x" Style="{StaticResource ChipButton}"
                        Margin="0,0,4,0" Padding="10,6" Click="SpeedButton_Click" Tag="1" />
                <Button x:Name="Speed2xButton" Content="2x" Style="{StaticResource ChipButton}"
                        Margin="0,0,4,0" Padding="10,6" Click="SpeedButton_Click" Tag="2" />
                <Button x:Name="Speed4xButton" Content="4x" Style="{StaticResource ChipButton}"
                        Margin="0,0,12,0" Padding="10,6" Click="SpeedButton_Click" Tag="4" />

                <Button x:Name="NextRoundButton" Content="⏭ Hiệp Kế"
                        Margin="0,0,8,0" Click="NextRoundButton_Click" />

                <Button x:Name="SkipButton" Content="⚡ Bỏ Qua Animation"
                        Click="SkipButton_Click" />
            </StackPanel>

            <!-- Center: Victory / Status Message -->
            <TextBlock Grid.Column="1" x:Name="FooterNoticeText"
                       Text="" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />

            <!-- Right Controls: Finish / Close -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="CloseButton" Content="Rời Lôi Đài"
                        Click="CloseButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
