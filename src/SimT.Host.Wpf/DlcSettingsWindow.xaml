<Window x:Class="SimT.Host.Wpf.DlcSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SimT.Host.Wpf.Controls"
        Title="Thiết Lập Hệ Thống &amp; Quản Lý DLC" Height="720" Width="800"
        MinHeight="620" MinWidth="720"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Border DockPanel.Dock="Left" Width="48" Height="48"
                    Background="{StaticResource SurfaceAlt}"
                    BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="8"
                    Margin="0,0,14,0">
                <TextBlock Text="⚙️" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="THIẾT LẬP HỆ THỐNG &amp; QUẢN LÝ DLC" Style="{StaticResource H1}" FontSize="18" />
                <TextBlock Text="Kiến trúc Modular · Quản trị 9 DLC Tam Quốc · Kiểm tra toàn vẹn Invariants"
                           Style="{StaticResource Caption}" Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Navigation Tabs -->
        <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,0,0,14">
            <UniformGrid Columns="3">
                <Button x:Name="TabDlcBtn" Content="📦 Danh Mục DLC" Click="TabDlc_Click"
                        Style="{StaticResource GhostButton}" FontWeight="Bold" />
                <Button x:Name="TabDiagnosticsBtn" Content="🛡️ Toàn Vẹn &amp; Chẩn Đoán" Click="TabDiagnostics_Click"
                        Style="{StaticResource GhostButton}" />
                <Button x:Name="TabOptionsBtn" Content="🎮 Tùy Chọn Game" Click="TabOptions_Click"
                        Style="{StaticResource GhostButton}" />
            </UniformGrid>
        </Border>

        <!-- Tab 1: DLC Matrix -->
        <Grid x:Name="TabDlcPanel" Grid.Row="2" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Summary Ribbon -->
            <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
                <DockPanel>
                    <TextBlock x:Name="DlcSummaryText" Style="{StaticResource Caption}" Foreground="{StaticResource Accent}"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="ℹ️ Tất cả DLC đều tuân thủ Zero-Coupling (giao tiếp qua CapabilityBroker)"
                               Style="{StaticResource Caption}" Foreground="{StaticResource Faint}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- List of DLCs -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="DlcListPanel" Margin="0,0,8,0" />
            </ScrollViewer>
        </Grid>

        <!-- Tab 2: Diagnostics & Invariants -->
        <Grid x:Name="TabDiagnosticsPanel" Grid.Row="2" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,8,0">
                    <!-- Invariants Card -->
                    <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                            BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Button Content="🔍 Chạy Kiểm Tra Invariants" Click="RunInvariants_Click"
                                        Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" Padding="12,6" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="KIỂM TRA TOÀN VẸN HỆ THỐNG (INVARIANTS)" Style="{StaticResource Overline}" />
                                    <TextBlock x:Name="InvariantStatusText" Text="Chưa chạy kiểm tra trong phiên này."
                                               Style="{StaticResource Caption}" Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <StackPanel x:Name="InvariantResultsPanel" />
                        </StackPanel>
                    </Border>

                    <!-- Save & Engine Details -->
                    <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                            BorderThickness="1" CornerRadius="6" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="THÔNG SỐ LƯU TRỮ &amp; ENGINE" Style="{StaticResource Overline}" Margin="0,0,0,8" />
                            <TextBlock x:Name="EngineInfoText" Style="{StaticResource Caption}" Foreground="{StaticResource Text}"
                                       TextWrapping="Wrap" LineHeight="20" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Tab 3: Options -->
        <Grid x:Name="TabOptionsPanel" Grid.Row="2" Visibility="Collapsed">
            <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="6" Padding="16,14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="TÙY CHỌN TRẢI NGHIỆM TRÒ CHƠI" Style="{StaticResource Overline}" Margin="0,0,0,12" />

                    <CheckBox x:Name="OptBilingualMode" Content="Chế độ Song ngữ Hán - Việt (Hiển thị nguyên tác Chữ Hán cho Danh Tướng, Địa Danh &amp; Kỳ Vật)"
                              IsChecked="False" Margin="0,0,0,12" Foreground="{StaticResource Text}" Click="OptBilingual_Click" />

                    <CheckBox x:Name="OptAutoSave" Content="Tự động lưu ván chơi sau mỗi lượt tiến ngày / tuần (Khuyến nghị)"
                              IsChecked="True" Margin="0,0,0,12" Foreground="{StaticResource Text}" />

                    <CheckBox x:Name="OptConfirmAdvance" Content="Xác nhận trước khi tiến tuần (+7 ngày) để tránh nhỡ việc"
                              IsChecked="True" Margin="0,0,0,12" Foreground="{StaticResource Text}" />

                    <CheckBox x:Name="OptShowAlerts" Content="Hiển thị cảnh báo biến cố thị trường &amp; hết hạn hợp đồng trên thanh Alert Feed"
                              IsChecked="True" Margin="0,0,0,16" Foreground="{StaticResource Text}" />

                    <TextBlock Text="ÂM THANH" Style="{StaticResource Overline}" Margin="0,8,0,10" />
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="Tổng" Width="100" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ElementName=AudioMaster, Path=Value, StringFormat={}{0:0}%}" DockPanel.Dock="Right" Width="48" TextAlignment="Right" />
                        <Slider x:Name="AudioMaster" AutomationProperties.Name="Tổng" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="AudioVolume_Changed" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="Nhạc" Width="100" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ElementName=AudioMusic, Path=Value, StringFormat={}{0:0}%}" DockPanel.Dock="Right" Width="48" TextAlignment="Right" />
                        <Slider x:Name="AudioMusic" AutomationProperties.Name="Nhạc" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="AudioVolume_Changed" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="Hiệu ứng" Width="100" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ElementName=AudioSfx, Path=Value, StringFormat={}{0:0}%}" DockPanel.Dock="Right" Width="48" TextAlignment="Right" />
                        <Slider x:Name="AudioSfx" AutomationProperties.Name="Hiệu ứng" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="AudioVolume_Changed" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="Môi trường" Width="100" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ElementName=AudioAmbience, Path=Value, StringFormat={}{0:0}%}" DockPanel.Dock="Right" Width="48" TextAlignment="Right" />
                        <Slider x:Name="AudioAmbience" AutomationProperties.Name="Môi trường" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="AudioVolume_Changed" />
                    </DockPanel>
                    <Button x:Name="AudioMute" Content="Tắt tiếng" Click="AudioMute_Click" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,0,0,12" />
                    <TextBlock Text="Âm lượng được lưu tự động theo người chơi trên máy này."
                               Style="{StaticResource Caption}" Foreground="{StaticResource Faint}" />
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Footer -->
        <DockPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Text="Phím tắt: [ESC] để đóng cửa sổ" Style="{StaticResource Caption}"
                       Foreground="{StaticResource Faint}" VerticalAlignment="Center" />
            <Button Content="Đóng" Click="Close_Click" Style="{StaticResource GhostButton}"
                    HorizontalAlignment="Right" MinWidth="85" />
        </DockPanel>
    </Grid>
</Window>
