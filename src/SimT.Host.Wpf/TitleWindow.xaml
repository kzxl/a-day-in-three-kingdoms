<Window x:Class="SimT.Host.Wpf.TitleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SimT — Tam Quốc Thương Đạo" Height="620" Width="820"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen">

    <Grid x:Name="TitleRoot" Margin="28" RenderTransformOrigin="0.5,0.5" Opacity="0">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="TitleScale" ScaleX="0.97" ScaleY="0.97" />
                <TranslateTransform x:Name="TitleTranslate" Y="8" />
            </TransformGroup>
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <Border DockPanel.Dock="Right" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Accent}"
                    BorderThickness="1" CornerRadius="6" Padding="10,6" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="漢末天下" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" />
                    <TextBlock Text="Năm 184 · Quan" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="SIMT" FontSize="32" FontWeight="Bold"
                               Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                    <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                            BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="三國商道 · RPG SIMULATION" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentHover}" />
                    </Border>
                </StackPanel>
                <TextBlock Style="{StaticResource Caption}" Margin="0,5,0,0"
                           Text="Mô phỏng thương gia Tam Quốc · Thị trường độc lập · Vận hành thế sự triều đình và bang phái" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Margin="0,20,0,14" Padding="14,12"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Khởi nghiệp ＋" Click="New_Click"
                        Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Padding="16,7" />
                <TextBlock DockPanel.Dock="Left" Text="Tên nhân vật / Hiệu buôn:" VerticalAlignment="Center"
                           Margin="0,0,12,0" Style="{StaticResource Caption}" />
                <TextBox x:Name="NameBox" Text="Lữ Khách" />
            </DockPanel>
        </Border>

        <ListBox x:Name="SaveList" Grid.Row="2" MouseDoubleClick="Load_DoubleClick"
                 ItemContainerStyle="{StaticResource SaveItem}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel LastChildFill="True">
                        <TextBlock Text="📜" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource Text}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Summary}" Margin="0,3,0,0" Foreground="{StaticResource Muted}" />
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="EmptyText" Grid.Row="2" Style="{StaticResource Caption}"
                   Foreground="{StaticResource Faint}" TextAlignment="Center"
                   VerticalAlignment="Center" Visibility="Collapsed"
                   Text="Chưa có dữ liệu ván chơi. Hãy nhập tên và chọn Khởi nghiệp để bắt đầu." />

        <DockPanel Grid.Row="3" Margin="0,16,0,0">
            <Button Content="⚙ Quản Lý DLC" Click="DlcManager_Click" Style="{StaticResource GhostButton}"
                    DockPanel.Dock="Left" ToolTip="Xem danh sách 9 DLC Tam Quốc &amp; kiểm tra toàn vẹn ván chơi" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Vào ván ▸" Click="Load_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Padding="18,7" />
                <Button Content="Nhân bản" Click="Duplicate_Click" Style="{StaticResource GhostButton}" Margin="0,0,8,0" />
                <Button Content="Xóa" Click="Delete_Click" Style="{StaticResource GhostButton}" />
            </StackPanel>
        </DockPanel>

        <TextBlock Grid.Row="4" x:Name="VersionText" Style="{StaticResource Caption}"
                   Foreground="{StaticResource Faint}" Margin="0,14,0,0" FontSize="10.5" />
    </Grid>
</Window>
