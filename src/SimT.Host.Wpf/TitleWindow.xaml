<Window x:Class="SimT.Host.Wpf.TitleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SimT — Chọn Ván" Height="580" Width="780"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="SIMT" FontSize="30" FontWeight="Bold" Foreground="{StaticResource AccentPure}" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                       Text="Mô phỏng thương nhân · offline một người chơi · mỗi ván một database riêng" />
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,22,0,12">
            <TextBlock Text="Tên ván mới" VerticalAlignment="Center" Margin="0,0,10,0" />
            <Button DockPanel.Dock="Right" Content="Tạo ván" Click="New_Click"
                    Style="{StaticResource AccentButton}" Margin="10,0,0,0" />
            <TextBox x:Name="NameBox" Text="Lữ Khách" />
        </DockPanel>

        <ListBox x:Name="SaveList" Grid.Row="2" MouseDoubleClick="Load_DoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Summary}" Margin="0,3,0,0" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Vào ván" Click="Load_Click" Style="{StaticResource AccentButton}" Margin="0,0,8,0" />
            <Button Content="Nhân bản" Click="Duplicate_Click" Margin="0,0,8,0" />
            <Button Content="Xóa" Click="Delete_Click" />
        </StackPanel>
    </Grid>
</Window>
