<Window x:Class="SimT.Host.Wpf.TitleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Một Ngày Ở Tam Quốc — Chọn Ván" Height="620" Width="820"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="MỘT NGÀY Ở TAM QUỐC" Style="{StaticResource Display}"
                       Foreground="{StaticResource Accent}" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                       Text="Mô phỏng thương nhân &amp; danh sĩ thời Hán mạt · một người chơi · offline · mỗi ván một database riêng" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                       Foreground="{StaticResource Faint}"
                       Text="Khởi đầu năm 184 · lịch 12 tháng 30 ngày · đơn vị tiền Quan" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,20,0,14" Padding="14,12"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Tạo ván" Click="New_Click"
                        Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" />
                <TextBlock DockPanel.Dock="Left" Text="Tên ván mới" VerticalAlignment="Center"
                           Margin="0,0,12,0" Style="{StaticResource Caption}" />
                <TextBox x:Name="NameBox" Text="Lữ Khách" />
            </DockPanel>
        </Border>

        <ListBox x:Name="SaveList" Grid.Row="2" MouseDoubleClick="Load_DoubleClick"
                 ItemContainerStyle="{StaticResource SaveItem}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Summary}" Margin="0,3,0,0" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="EmptyText" Grid.Row="2" Style="{StaticResource Caption}"
                   Foreground="{StaticResource Faint}" TextAlignment="Center"
                   VerticalAlignment="Center" Visibility="Collapsed"
                   Text="Chưa có ván nào. Gõ tên rồi bấm Tạo ván." />

        <DockPanel Grid.Row="3" Margin="0,16,0,0">
            <Button Click="DlcManager_Click" Style="{StaticResource GhostButton}"
                    DockPanel.Dock="Left" ToolTip="Xem danh sách DLC Tam Quốc &amp; kiểm tra toàn vẹn ván chơi">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M12,8 A4,4 0 1,0 12,16 A4,4 0 1,0 12,8 M12,2 L12,5 M12,19 L12,22 M2,12 L5,12 M19,12 L22,12 M4.9,4.9 L7,7 M17,17 L19.1,19.1 M19.1,4.9 L17,7 M7,17 L4.9,19.1"
                          Stroke="{StaticResource Accent}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Quản Lý DLC" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Vào ván" Click="Load_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
                <Button Content="Nhân bản" Click="Duplicate_Click" Style="{StaticResource GhostButton}" Margin="0,0,8,0" />
                <Button Content="Xóa" Click="Delete_Click" Style="{StaticResource GhostButton}" />
            </StackPanel>
        </DockPanel>

        <TextBlock Grid.Row="4" x:Name="VersionText" Style="{StaticResource Caption}"
                   Foreground="{StaticResource Faint}" Margin="0,14,0,0" FontSize="10.5" />
    </Grid>
</Window>
