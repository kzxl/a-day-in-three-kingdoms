<Window x:Class="SimT.Host.Wpf.TitleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SimT.Host.Wpf.Controls"
        Title="Một Ngày Ở Tam Quốc — Khởi Nghiệp &amp; Chọn Ván"
        Height="700" Width="1040"
        MinHeight="620" MinWidth="920"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <!-- Background Layer: Ancient Market Artwork -->
        <Image x:Name="BgImage" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.18" />

        <!-- Radial Scrim / Vignette overlay to keep text & UI high-contrast lacquer -->
        <Border Background="{StaticResource TitleVignetteBrush}" />

        <!-- Subtle Ambient Particles Canvas: Floating Stroll Petals / Golden Embers -->
        <controls:GameAmbientParticlesControl Kind="StrollPetals" Opacity="0.35" IsHitTestVisible="False" />

        <!-- Main Foreground Layout -->
        <Grid x:Name="TitleRoot" Margin="26,20,26,18" RenderTransformOrigin="0.5,0.5" Opacity="0">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="TitleScale" ScaleX="0.97" ScaleY="0.97" />
                    <TranslateTransform x:Name="TitleTranslate" Y="8" />
                </TransformGroup>
            </Grid.RenderTransform>

            <Grid.RowDefinitions>
                <!-- Row 0: Top Branding Header -->
                <RowDefinition Height="Auto" />
                <!-- Row 1: Master-Detail Core Workspace -->
                <RowDefinition Height="*" />
                <!-- Row 2: Status & Quick Commands Footer -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ================= Row 0: Top Branding Header ================= -->
            <DockPanel Grid.Row="0" Margin="0,0,0,16">
                <!-- Right Side: Ancient Era Seal & Utility Actions -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <controls:GameButton Label="Thư mục Save" Variant="Secondary"
                                         IconPathData="M3,4 L10,4 L12,7 L21,7 L21,18 L3,18 Z"
                                         Click="OpenSaveFolder_Click" Margin="0,0,8,0"
                                         ToolTip="Mở thư mục lưu trữ ván chơi trong Windows Explorer" />

                    <controls:GameButton Label="Làm mới" Variant="Secondary"
                                         IconPathData="M4,12 A8,8 0 0,1 18.5,6.5 L20,4 L20,9 L15,9 L17.1,7.2 A6,6 0 1,0 18,12"
                                         Click="Refresh_Click" Margin="0,0,14,0"
                                         ToolTip="Quét lại danh sách ván lưu từ đĩa (F5)" />

                    <!-- Imperial Era Seal Badge -->
                    <Border Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Accent}"
                            BorderThickness="1.5" CornerRadius="6" Padding="12,6" VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="漢末天下" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" />
                            <TextBlock Text="Năm 184 · Quan Thương" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,1,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Left Side: Majestic Game Title -->
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="MỘT NGÀY Ở TAM QUỐC" Style="{StaticResource Display}"
                               FontSize="26" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" FontSize="12"
                               Text="Mô phỏng thương gia Tam Quốc · Thị trường độc lập · Vận hành thế sự triều đình và bang phái" />
                </StackPanel>
            </DockPanel>

            <!-- ================= Row 1: Master-Detail Core Workspace ================= -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <!-- Left: New Campaign + Save Slots List -->
                    <ColumnDefinition Width="410" MinWidth="340" />
                    <!-- Column Separator -->
                    <ColumnDefinition Width="16" />
                    <!-- Right: Save Details Dossier & Action Deck -->
                    <ColumnDefinition Width="*" MinWidth="440" />
                </Grid.ColumnDefinitions>

                <!-- ================= LEFT COLUMN ================= -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <!-- Box 1: Khởi Nghiệp Mới -->
                        <RowDefinition Height="Auto" />
                        <!-- Box 2: Header ván đã lưu -->
                        <RowDefinition Height="Auto" />
                        <!-- Box 3: Danh sách ván -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Khởi Nghiệp Mới (Tạo Ván Mới) -->
                    <Border Grid.Row="0" Margin="0,0,0,12" Padding="14,12"
                            Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                            BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="⚔️ KHỞI NGHIỆP MỚI" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                                <TextBlock Text="Bắt đầu thương lộ mới" Style="{StaticResource Caption}" HorizontalAlignment="Right" Foreground="{StaticResource Faint}" VerticalAlignment="Center" />
                            </DockPanel>

                            <DockPanel LastChildFill="True">
                                <controls:GameButton x:Name="NewCampaignButton" DockPanel.Dock="Right" Label="Khởi nghiệp" Variant="Primary"
                                                     Click="New_Click" Margin="10,0,0,0"
                                                     IconPathData="M14.5,4 L16.5,6 L7,15.5 L4,16 L4.5,13 L14.5,4 Z"
                                                     ToolTip="Tạo ván chơi mới tại thành Lạc Dương (Nhấn Enter)" />
                                <TextBox x:Name="NameBox" Text="Lữ Khách" VerticalAlignment="Center"
                                         ToolTip="Nhập tên nhân vật hoặc hiệu buôn của bạn" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Header Danh Sách Ván Lưu -->
                    <DockPanel Grid.Row="1" Margin="2,0,2,8">
                        <TextBlock Text="📜 CÁC VÁN ĐÃ LƯU" Style="{StaticResource Overline}" FontSize="11"
                                   Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                        <Border x:Name="SaveCountBadge" Background="{StaticResource SurfaceAlt}"
                                BorderBrush="{StaticResource LineSoft}" BorderThickness="1"
                                CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                            <TextBlock x:Name="SaveCountText" Text="0 ván" FontSize="10.5" Foreground="{StaticResource Accent}" FontWeight="SemiBold" />
                        </Border>
                    </DockPanel>

                    <!-- Save List Box -->
                    <ListBox x:Name="SaveList" Grid.Row="2"
                             SelectionChanged="SaveList_SelectionChanged"
                             MouseDoubleClick="Load_DoubleClick"
                             ItemContainerStyle="{StaticResource SaveItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left Seal Glyph -->
                                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="6"
                                            Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                                            BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="商" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Accent}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Middle Details -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource Ink}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="🏯 " FontSize="11" Foreground="{StaticResource Accent}" />
                                            <TextBlock Text="{Binding CityName}" FontSize="11.5" Foreground="{StaticResource Text}" FontWeight="SemiBold" />
                                            <TextBlock Text=" · " FontSize="11.5" Foreground="{StaticResource Faint}" />
                                            <TextBlock Text="{Binding FormattedDate}" FontSize="11.5" Foreground="{StaticResource Muted}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding LastPlayedText, StringFormat='Lưu lúc: {0}'}" FontSize="10" Foreground="{StaticResource Faint}" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <!-- Right Arrow / Status Glyph -->
                                    <TextBlock Grid.Column="2" Text="›" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Faint}"
                                               VerticalAlignment="Center" Margin="6,0,2,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty State for Save List -->
                    <controls:GameEmptyState x:Name="EmptyStateControl" Grid.Row="2" Visibility="Collapsed" />
                </Grid>

                <!-- ================= RIGHT COLUMN: DOSSIER & ACTIONS ================= -->
                <Grid Grid.Column="2">
                    <!-- Selected Save Dossier Panel -->
                    <Border x:Name="DossierRoot" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                            BorderThickness="1" CornerRadius="8" Padding="18,16" Visibility="Visible">
                        <Grid>
                            <Grid.RowDefinitions>
                                <!-- Dossier Header -->
                                <RowDefinition Height="Auto" />
                                <!-- Key Metrics 2x2 Grid -->
                                <RowDefinition Height="Auto" />
                                <!-- DLC & Extensions Active -->
                                <RowDefinition Height="Auto" />
                                <!-- Storage & Info Details -->
                                <RowDefinition Height="*" />
                                <!-- Action Button Deck -->
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 1. Dossier Header -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,14">
                                <!-- Large Seal Box -->
                                <Border DockPanel.Dock="Left" Width="52" Height="52" CornerRadius="8"
                                        Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Accent}"
                                        BorderThickness="1.5" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Text="漢" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Accent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <!-- Top Right ID Chip -->
                                <Border DockPanel.Dock="Right" Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource LineSoft}"
                                        BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding CampaignIdShort, StringFormat='Mã: #{0}'}" FontSize="10.5"
                                               Foreground="{StaticResource Faint}" FontFamily="Consolas" />
                                </Border>

                                <!-- Identity & Status -->
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource H1}" FontSize="20" FontWeight="Bold"
                                               Foreground="{StaticResource Ink}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="🏯 Vị trí: " Style="{StaticResource Caption}" Foreground="{StaticResource Faint}" />
                                        <TextBlock Text="{Binding CityName}" Style="{StaticResource Caption}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding RegionDisplay}" Style="{StaticResource Caption}" Foreground="{StaticResource Muted}" Margin="4,0,0,0" />
                                        <TextBlock Text=" · " Style="{StaticResource Caption}" Foreground="{StaticResource Faint}" />
                                        <TextBlock Text="📅 " Style="{StaticResource Caption}" Foreground="{StaticResource Faint}" />
                                        <TextBlock Text="{Binding FormattedDate}" Style="{StaticResource Caption}" Foreground="{StaticResource Text}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding FameTitle, StringFormat='Danh hiệu: {0}'}" FontSize="11"
                                               Foreground="{StaticResource AccentHover}" Margin="0,3,0,0" FontWeight="SemiBold" />
                                </StackPanel>
                            </DockPanel>

                            <!-- 2. Key Metrics Grid (Ngân Lượng, Danh Vọng, Đức Hạnh, Tín Nghĩa) -->
                            <Border Grid.Row="1" Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource LineSoft}"
                                    BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,14">
                                <UniformGrid Columns="2" Rows="2">
                                    <!-- Metric 1: Ngân Lượng -->
                                    <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,1,1" Padding="8,6">
                                        <StackPanel>
                                            <TextBlock Text="💰 NGÂN LƯỢNG TIỀN MẶT" Style="{StaticResource Overline}" />
                                            <TextBlock Text="{Binding WalletText}" Style="{StaticResource NumberLarge}"
                                                       FontSize="17" Margin="0,3,0,1" Foreground="{StaticResource Accent}" />
                                            <TextBlock Text="Quan tiền trong bao" Style="{StaticResource Caption}" FontSize="10.5" Foreground="{StaticResource Faint}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Metric 2: Danh Vọng -->
                                    <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1" Padding="12,6,8,6">
                                        <StackPanel>
                                            <TextBlock Text="🌟 DANH VỌNG GIANG HỒ" Style="{StaticResource Overline}" />
                                            <TextBlock Text="{Binding FameText}" Style="{StaticResource NumberLarge}"
                                                       FontSize="17" Margin="0,3,0,1" Foreground="{StaticResource Ink}" />
                                            <TextBlock Text="{Binding FameTitle}" Style="{StaticResource Caption}" FontSize="10.5" Foreground="{StaticResource Muted}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Metric 3: Đức Hạnh -->
                                    <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,1,0" Padding="8,8,8,4">
                                        <StackPanel>
                                            <TextBlock Text="🕊️ ĐỨC HẠNH XÃ TẮC" Style="{StaticResource Overline}" />
                                            <TextBlock Text="{Binding VirtueText}" Style="{StaticResource NumberLarge}"
                                                       FontSize="17" Margin="0,3,0,1" Foreground="{StaticResource Gain}" />
                                            <TextBlock Text="Lòng dân tín phục" Style="{StaticResource Caption}" FontSize="10.5" Foreground="{StaticResource Faint}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Metric 4: Tín Nghĩa -->
                                    <Border Padding="12,8,8,4">
                                        <StackPanel>
                                            <TextBlock Text="⚖️ TÍN NGHĨA THƯƠNG TRƯỜNG" Style="{StaticResource Overline}" />
                                            <TextBlock Text="{Binding CredibilityText}" Style="{StaticResource NumberLarge}"
                                                       FontSize="17" Margin="0,3,0,1" Foreground="{StaticResource Azure}" />
                                            <TextBlock Text="Chữ tín thương gia" Style="{StaticResource Caption}" FontSize="10.5" Foreground="{StaticResource Faint}" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </Border>

                            <!-- 3. Active DLCs & Extensions -->
                            <StackPanel Grid.Row="2" Margin="0,0,0,14">
                                <TextBlock Text="📦 CÁC GÓI MỞ RỘNG (DLC) HOẠT ĐỘNG" Style="{StaticResource Overline}"
                                           Foreground="{StaticResource Muted}" Margin="0,0,0,6" />
                                <WrapPanel x:Name="DlcBadgesPanel">
                                    <!-- Badges injected dynamically in code or fallback -->
                                </WrapPanel>
                            </StackPanel>

                            <!-- 4. Save Storage Info / Session Details -->
                            <Border Grid.Row="3" Background="{StaticResource Bg}" BorderBrush="{StaticResource LineSoft}"
                                    BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,16" VerticalAlignment="Top">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,3">
                                        <TextBlock Text="Lần chơi gần nhất:" Style="{StaticResource Caption}" Foreground="{StaticResource Faint}" />
                                        <TextBlock Text="{Binding LastPlayedText}" Style="{StaticResource Caption}" Foreground="{StaticResource Text}" HorizontalAlignment="Right" />
                                    </DockPanel>
                                    <DockPanel>
                                        <TextBlock Text="Thư mục ván:" Style="{StaticResource Caption}" Foreground="{StaticResource Faint}" />
                                        <TextBlock Text="{Binding CampaignIdShort, StringFormat='saves/{0} (SQLite WAL)'}"
                                                   Style="{StaticResource Caption}" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" FontFamily="Consolas" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <!-- 5. Action Button Deck -->
                            <StackPanel Grid.Row="4">
                                <!-- Big Primary Enter Button -->
                                <controls:GameButton x:Name="EnterGameButton" Label="VÀO VÁN CHƠI" Variant="Primary" Click="Load_Click"
                                                     Height="42" FontSize="14" Margin="0,0,0,10"
                                                     CostText="Enter"
                                                     IconPathData="M14.5,4 L16.5,6 L7,15.5 L4,16 L4.5,13 L14.5,4 Z"
                                                     ToolTip="Tiếp tục cuộc hành trình thương gia (Phím tắt: Enter hoặc Double-click)" />

                                <!-- Sub-actions row -->
                                <UniformGrid Columns="4">
                                    <controls:GameButton Label="Quản lý DLC" Variant="Secondary"
                                                         IconPathData="M12,8 A4,4 0 1,0 12,16 A4,4 0 1,0 12,8 M12,2 L12,5 M12,19 L12,22 M2,12 L5,12 M19,12 L22,12 M4.9,4.9 L7,7 M17,17 L19.1,19.1 M19.1,4.9 L17,7 M7,17 L4.9,19.1"
                                                         Click="DlcManager_Click" Margin="0,0,6,0"
                                                         ToolTip="Kiểm tra tính tương thích và toàn vẹn của các DLC" />

                                    <controls:GameButton Label="Nhân bản" Variant="Secondary"
                                                         IconPathData="M4,4 L16,4 L16,16 L4,16 Z M8,8 L20,8 L20,20 L8,20 Z"
                                                         Click="Duplicate_Click" Margin="0,0,6,0"
                                                         ToolTip="Tạo bản sao độc lập của ván này để thử nghiệm chiến lược mới" />

                                    <controls:GameButton Label="Mở Thư Mục" Variant="Secondary"
                                                         IconPathData="M3,4 L10,4 L12,7 L21,7 L21,18 L3,18 Z"
                                                         Click="OpenSaveFolder_Click" Margin="0,0,6,0"
                                                         ToolTip="Mở thư mục tệp tin lưu trữ ván này trong Windows Explorer" />

                                    <controls:GameButton Label="Xóa Ván" Variant="Danger"
                                                         IconPathData="M6,7 L18,7 M9,7 L9,4 L15,4 L15,7 M8,7 L9,19 L15,19 L16,7"
                                                         Click="Delete_Click"
                                                         ToolTip="Xóa vĩnh viễn ván chơi này (có hộp thoại xác nhận an toàn)" />
                                </UniformGrid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Welcome / Empty Dossier Panel (Shown when no save is selected) -->
                    <Border x:Name="WelcomeRoot" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                            BorderThickness="1" CornerRadius="8" Padding="28" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440">
                            <TextBlock Text="🏮" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,14" />
                            <TextBlock Text="HÁN MẠT THƯƠNG LỘ PHONG VÂN" Style="{StaticResource H1}" FontSize="18"
                                       Foreground="{StaticResource Accent}" HorizontalAlignment="Center" Margin="0,0,0,10" />
                            <TextBlock Text="Năm 184 (Trung Bình nguyên niên), thiên hạ đại loạn, Khăn Vàng nổi dậy khắp tám châu. Triều đình suy vi, quần hùng cát cứ, cũng là lúc thời cơ thương nghiệp ngàn năm có một mở ra."
                                       Style="{StaticResource Caption}" Foreground="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,16" />
                            <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource LineSoft}" BorderThickness="1" CornerRadius="6" Padding="14,12">
                                <TextBlock Text="👉 Hãy nhập tên hiệu buôn ở khung bên trái và bấm 'Khởi nghiệp' để bước vào con đường buôn bán, gây dựng cơ nghiệp thời Tam Quốc!"
                                           Style="{StaticResource Caption}" Foreground="{StaticResource Ink}" TextAlignment="Center" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ================= Row 2: Status & Quick Commands Footer ================= -->
            <DockPanel Grid.Row="2" Margin="0,4,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="[Enter: Vào ván / Khởi nghiệp]  ·  [F5: Quét lại]  ·  [Esc: Thoát]"
                               Style="{StaticResource Caption}" Foreground="{StaticResource Faint}" FontSize="11" Margin="0,0,14,0" VerticalAlignment="Center" />
                    <controls:GameButton Label="Thoát Game" Variant="Secondary" IsCompact="True" Click="Exit_Click"
                                         ToolTip="Thoát trò chơi" />
                </StackPanel>

                <TextBlock x:Name="VersionText" Style="{StaticResource Caption}"
                           Foreground="{StaticResource Faint}" FontSize="11" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Grid>
    </Grid>
</Window>
