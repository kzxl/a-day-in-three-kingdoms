<Window x:Class="SimT.Host.Wpf.CityStrollModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SimT.Host.Wpf.Controls"
        Title="Kỳ Ngộ Du Ngoạn Phố Phường — Tam Quốc Tiêu Dao Ký"
        Height="680" Width="820"
        MinHeight="560" MinWidth="740"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid Margin="18,14,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Row 0: Scene Header: Event Glyph, Title, Category Badge & Venue ===== -->
        <Border Grid.Row="0" x:Name="HeaderBorder" Background="{StaticResource SurfaceAlt}"
                BorderBrush="{StaticResource Line}" BorderThickness="1"
                CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Icon Box -->
                <Border Grid.Column="0" Width="64" Height="64"
                        x:Name="IconBox"
                        Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource Accent}" BorderThickness="2"
                        CornerRadius="8" Margin="0,0,14,0"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="EventGlyphText" Text="🏮"
                               FontSize="32"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Title & Location -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <Border x:Name="CategoryBadge" Background="{StaticResource AccentSoft}"
                                BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="3" Padding="6,1" Margin="0,0,8,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="CategoryText" Text="KỲ NGỘ PHỐ PHƯỜNG"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource Accent}" />
                        </Border>
                        <TextBlock x:Name="LocationVenueText" Text="📍 Nội Thị Lạc Dương"
                                   FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock x:Name="EventTitleText" Text="Kỳ Thương Cổ Vật"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Stroll Date & Counter -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                            BorderThickness="1" CornerRadius="4" Padding="8,4">
                        <TextBlock x:Name="DateCounterText" Text="Ngày 184-04-15"
                                   Style="{StaticResource Caption}" Foreground="{StaticResource Muted}" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Row 1: Narrative Story Parchment & Interactive Choices & Reward Strip & History ===== -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Main Narrative Scroll -->
            <Border Grid.Row="0" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="8" Padding="16,14" Margin="0,0,0,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="StoryStack">
                        <TextBlock Text="CỐT TRUYỆN KỲ NGỘ &amp; DIỄN BIẾN PHỐ PHƯỜNG"
                                   Style="{StaticResource Overline}" Margin="0,0,0,8" />
                        <TextBlock x:Name="NarrativeText"
                                   FontSize="14" LineHeight="22"
                                   Foreground="{StaticResource Text}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Interactive Encounter Choices (Merchant Barter / General Dialogue) -->
            <Border Grid.Row="1" x:Name="ChoicesBorder"
                    Background="{StaticResource SurfaceAlt}"
                    BorderBrush="{StaticResource Accent}" BorderThickness="1.5"
                    CornerRadius="8" Padding="14,12" Margin="0,0,0,10"
                    Visibility="Collapsed">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock x:Name="ChoicesHeadingText" Text="❖ QUYẾT ĐỊNH TƯƠNG TÁC KỲ NGỘ"
                                   Style="{StaticResource Overline}" Foreground="{StaticResource Accent}" />
                        <TextBlock x:Name="ChoicesSubHeadingText" Text="Hãy chọn 1 hành động thích hợp để tiếp tục"
                                   HorizontalAlignment="Right" Style="{StaticResource Caption}" Foreground="{StaticResource Muted}" />
                    </DockPanel>

                    <!-- Wandering Merchant Merchandise Cards -->
                    <ItemsControl x:Name="MerchantOffersList" Visibility="Collapsed">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Surface}"
                                        BorderBrush="{StaticResource Line}" BorderThickness="1"
                                        CornerRadius="6" Padding="10,8" Margin="4,0,4,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Header: Icon + Name -->
                                        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,6">
                                            <Border Width="44" Height="44" Background="{StaticResource Rail}"
                                                    BorderBrush="{StaticResource Line}" BorderThickness="1"
                                                    CornerRadius="6" HorizontalAlignment="Center" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding VisualIcon}" FontSize="24"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{Binding ItemNameVi}" FontWeight="Bold" FontSize="12.5"
                                                       Foreground="{StaticResource Text}" HorizontalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding CategoryVi}" FontSize="10.5"
                                                       Foreground="{StaticResource Muted}" HorizontalAlignment="Center" />
                                        </StackPanel>

                                        <!-- Description -->
                                        <TextBlock Grid.Row="1" Text="{Binding DescriptionVi}"
                                                   Style="{StaticResource Caption}" Foreground="{StaticResource Faint}"
                                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,8" />

                                        <!-- Buy Button -->
                                        <Button Grid.Row="2" Style="{StaticResource PrimaryButton}"
                                                Padding="8,5" FontWeight="Bold" FontSize="11.5"
                                                Tag="{Binding ItemId}"
                                                Click="BuyOffer_Click">
                                            <TextBlock Text="{Binding UnitPrice, StringFormat='Mua ({0} Quan)'}" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- General / Scholar Dialogue Choices -->
                    <StackPanel x:Name="NpcChoicesPanel" Visibility="Collapsed" />

                    <!-- Decline Button (for Merchant) -->
                    <controls:GameButton x:Name="DeclineMerchantBtn" Label="Cáo Biệt Không Mua"
                                         Variant="Secondary"
                                         HorizontalAlignment="Center" Margin="0,8,0,0"
                                         Visibility="Collapsed" Click="DeclineMerchant_Click" />
                </StackPanel>
            </Border>

            <!-- Reward Impact Strip -->
            <Border Grid.Row="2" x:Name="RewardStripBorder" Background="{StaticResource Rail}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
                <DockPanel>
                    <TextBlock Text="✦ THU HOẠCH:"
                               Style="{StaticResource Overline}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <WrapPanel x:Name="RewardBadgesPanel" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Chronicle / History Expander -->
            <Expander Grid.Row="3" Header="📜 Nhật Ký 5 Kỳ Ngộ Gần Nhất Tại Phố Phường"
                      Foreground="{StaticResource Muted}" FontSize="11.5"
                      IsExpanded="False" Margin="0,0,0,4">
                <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,4,0,0"
                        MaxHeight="130">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="HistoryList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2,0,4">
                                        <TextBlock Text="{Binding TimeText}" Style="{StaticResource Caption}"
                                                   Foreground="{StaticResource Faint}" Width="85" />
                                        <TextBlock Text="{Binding Glyph}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="11"
                                                   Foreground="{StaticResource Text}" Width="150" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding LocationName}" FontSize="10.5"
                                                   Foreground="{StaticResource Accent}" Margin="0,0,8,0" Width="100" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding RewardSummary}" Style="{StaticResource Caption}"
                                                   Foreground="{StaticResource Gain}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Expander>
        </Grid>

        <!-- ===== Row 2: Bottom Control Bar ===== -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceAlt}"
                BorderBrush="{StaticResource Line}" BorderThickness="1"
                CornerRadius="8" Padding="12,10" Margin="0,8,0,0">
            <DockPanel LastChildFill="False">
                <!-- Left: Vitals Status (Fatigue & Stress) -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="VitalsStatusText"
                               Text="⚡ Thể Lực: Ổn định · 💤 Mệt mỏi: 20%"
                               Style="{StaticResource Caption}"
                               Foreground="{StaticResource Muted}" />
                </StackPanel>

                <!-- Right: Action Buttons -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <controls:GameButton x:Name="ContinueStrollBtn" Label="Tiếp Tục Dạo Bước"
                                         Variant="Primary"
                                         Margin="0,0,8,0"
                                         Click="ContinueStroll_Click"
                                         ToolTip="Dạo thêm một bước phố phường (tiêu hao 5 mệt mỏi, giảm 12 căng thẳng)" />
                    <controls:GameButton Label="Trở Về"
                                         Variant="Secondary"
                                         Click="Close_Click" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
