<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>SimT.Host.Wpf</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SimT.Contracts\SimT.Contracts.csproj" />
    <ProjectReference Include="..\SimT.Core\SimT.Core.csproj" />
  </ItemGroup>

  <!-- Same rule as the CLI: modules are build artefacts, not compile-time references. -->
  <ItemGroup>
    <ModuleProject Include="..\SimT.Modules.Base.Content\SimT.Modules.Base.Content.csproj" />
    <ModuleProject Include="..\SimT.Modules.Base.World\SimT.Modules.Base.World.csproj" />
    <ModuleProject Include="..\SimT.Modules.Base.Player\SimT.Modules.Base.Player.csproj" />
    <ModuleProject Include="..\SimT.Modules.Base.Npc\SimT.Modules.Base.Npc.csproj" />
    <ModuleProject Include="..\SimT.Modules.Dlc.Economy\SimT.Modules.Dlc.Economy.csproj" />
    <ModuleProject Include="..\SimT.Modules.Dlc.Character\SimT.Modules.Dlc.Character.csproj" />
    <ModuleProject Include="..\SimT.Modules.Dlc.Power\SimT.Modules.Dlc.Power.csproj" />
    <ModuleProject Include="..\SimT.Modules.Dlc.Society\SimT.Modules.Dlc.Society.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="@(ModuleProject)" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <Target Name="CopyModules" AfterTargets="Build">
    <ItemGroup>
      <ModuleArtifact Include="@(ModuleProject->'%(RootDir)%(Directory)bin\$(Configuration)\net8.0\%(Filename).dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(ModuleArtifact)" DestinationFolder="$(OutDir)Modules" SkipUnchangedFiles="true" />
  </Target>

  <!-- Publish needs the same artefacts: the DLC DLLs stay outside the single-file bundle so a
       module can be added or removed without rebuilding the host. -->
  <Target Name="CopyModulesOnPublish" AfterTargets="Publish">
    <ItemGroup>
      <PublishModuleArtifact Include="@(ModuleProject->'%(RootDir)%(Directory)bin\$(Configuration)\net8.0\%(Filename).dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(PublishModuleArtifact)" DestinationFolder="$(PublishDir)Modules" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <None Include="..\..\assets\**\*" LinkBase="assets" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\languages\**\*" LinkBase="languages" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
  </ItemGroup>

</Project>
