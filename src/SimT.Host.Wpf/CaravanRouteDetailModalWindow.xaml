<local:HubModalWindowBase x:Class="SimT.Host.Wpf.CaravanRouteDetailModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SimT.Host.Wpf"
        xmlns:controls="clr-namespace:SimT.Host.Wpf.Controls"
        Title="Tiêu Cục Quân Cơ · Lộ Trình Vận Tiêu &amp; Chênh Lệch Giá Buôn"
        Height="720" Width="920"
        MinHeight="620" MinWidth="820"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= ROW 0: GAME HUB HEADER ================= -->
        <controls:GameHubHeader Grid.Row="0" x:Name="HubHeader" />

        <!-- ================= ROW 1: ROUTE DOSSIER ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== LEFT COLUMN: LOGISTICS, AMBUSH RISK & FLEET ===== -->
            <Border Grid.Column="0" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="8" Padding="16,14" Margin="0,0,12,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="THÔNG TIN LỘ TRÌNH &amp; PHÒNG BỊ TIÊU CỤC"
                                   Style="{StaticResource Overline}" Foreground="{StaticResource Accent}" Margin="0,0,0,10" />

                        <!-- Origin to Destination Route Card -->
                        <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="NƠI KHỞI HÀNH" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="OriginCityText" Text="Lạc Dương" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Text}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="➔" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="10,0" />

                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock Text="ĐÍCH ĐẾN" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="DestCityText" Text="Trường An" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Text}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Route Metrics -->
                        <UniformGrid Columns="2" Margin="0,0,0,12">
                            <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                                    BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,4,6">
                                <StackPanel>
                                    <TextBlock Text="🗺 CỰ LY HÀNH TRÌNH" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                                    <TextBlock x:Name="RouteDistanceText" Text="350 Dặm" Style="{StaticResource NumberLarge}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                                    BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="4,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="⏳ THỜI GIAN VẬN CHUYỂN" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                                    <TextBlock x:Name="RouteDaysText" Text="3 Ngày" Style="{StaticResource NumberLarge}" Foreground="{StaticResource Accent}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                                    BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,4,4,0">
                                <StackPanel>
                                    <TextBlock Text="⚠️ NGUY CƠ MAI PHỤC" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Loss}" />
                                    <TextBlock x:Name="AmbushRiskText" Text="15% Thấp" Style="{StaticResource NumberLarge}" Foreground="{StaticResource Loss}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                                    BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="4,4,0,0">
                                <StackPanel>
                                    <TextBlock Text="📦 ĐỘI XE HIỆN TẠI" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Gain}" />
                                    <TextBlock x:Name="FleetTierText" Text="Xe Thồ Cấp 1" Style="{StaticResource NumberLarge}" Foreground="{StaticResource Gain}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Escort Warrior Info -->
                        <TextBlock Text="Võ Tướng Bảo Tiêu Hộ Tống" Style="{StaticResource Caption}"
                                   Foreground="{StaticResource Muted}" Margin="0,0,0,4" />
                        <Border x:Name="EscortCardBorder" Background="{StaticResource Rail}"
                                BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                            <DockPanel>
                                <TextBlock Text="🛡️" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="EscortNameText" Text="Chưa phân bổ Tiêu Sư hộ tống" FontWeight="Bold" FontSize="12" Foreground="{StaticResource Text}" />
                                    <TextBlock x:Name="EscortSubText" Text="Có thể cắt cử võ tướng môn khách bảo vệ để giảm 80% nguy cơ cướp bóc" Style="{StaticResource Caption}" Foreground="{StaticResource Muted}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ===== RIGHT COLUMN: PROFITABLE COMMODITIES & CONTRACTS ===== -->
            <Border Grid.Column="1" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="8" Padding="18,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Arbitrage Header -->
                            <TextBlock Text="💰 CƠ HỘI BUÔN CHUYẾN SINH LỜI (CHÊNH LỆCH GIÁ)"
                                       Style="{StaticResource Overline}" Foreground="{StaticResource Gain}" Margin="0,0,0,8" />

                            <ItemsControl x:Name="CommodityArbitrageList" Margin="0,0,0,16">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                                                BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                            <DockPanel>
                                                <TextBlock Text="{Binding Glyph}" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ItemNameVi}" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Text}" />
                                                    <TextBlock Text="{Binding PriceComparisonText}" Style="{StaticResource Caption}" Foreground="{StaticResource Muted}" />
                                                </StackPanel>
                                                <Border Background="{StaticResource AccentSoft}" CornerRadius="4" Padding="8,4"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ProfitMarginText}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource Gain}" />
                                                </Border>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Contracts along this route -->
                            <TextBlock Text="📜 HỢP ĐỒNG VẬN TIÊU KHẢ DỤNG DỌC ĐƯỜNG"
                                       Style="{StaticResource Overline}" Margin="0,0,0,8" />

                            <ItemsControl x:Name="ContractsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                                                BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                            <DockPanel>
                                                <TextBlock Text="📦" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TitleVi}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource Text}" />
                                                    <TextBlock Text="{Binding GuildName}" Style="{StaticResource Caption}" Foreground="{StaticResource Muted}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding RewardText}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="12" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom Action Strip -->
                    <Border Grid.Row="1" Background="{StaticResource SurfaceAlt}"
                            BorderBrush="{StaticResource Line}" BorderThickness="1"
                            CornerRadius="8" Padding="12,10" Margin="0,12,0,0">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                <TextBlock x:Name="RouteStatusText" Text="Phí vận chuyển: 25 Quan / kiện hàng"
                                           Style="{StaticResource Caption}" Foreground="{StaticResource Muted}" />
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="DispatchCaravanBtn" Content="📦 Phát Hàng Vận Tiêu"
                                        Style="{StaticResource PrimaryButton}"
                                        FontWeight="Bold" Padding="16,8" Margin="0,0,8,0"
                                        Click="DispatchCaravan_Click" />
                                <Button Content="Trở Về"
                                        Style="{StaticResource GhostButton}"
                                        Padding="16,8"
                                        Click="Close_Click" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</local:HubModalWindowBase>
