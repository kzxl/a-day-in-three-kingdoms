<Window x:Class="SimT.Host.Wpf.ItemDetailModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bách Vật Đồ Giám — Tra Cứu Kỳ Vật &amp; Nông Cụ"
        Height="720" Width="820"
        MinHeight="620" MinWidth="740"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid Margin="18,14,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Header: Avatar Glyph, Identity, Category, Base Price & Badges ===== -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceAlt}"
                BorderBrush="{StaticResource Line}" BorderThickness="1"
                CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Icon Box -->
                <Border Grid.Column="0" Width="68" Height="68"
                        Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource Accent}" BorderThickness="2"
                        CornerRadius="8" Margin="0,0,14,0"
                        VerticalAlignment="Center">
                    <Grid>
                        <TextBlock x:Name="IconGlyphText" Text="📦"
                                   FontSize="34"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Border Background="{StaticResource AccentSoft}" CornerRadius="0,0,6,0"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Padding="4,1">
                            <TextBlock x:Name="CategoryTagSmall" Text="KỲ VẬT" FontSize="9"
                                       Foreground="{StaticResource Accent}" FontWeight="Bold" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Names & Overview -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="NameViText" Style="{StaticResource Display}" FontSize="20"
                                   Foreground="{StaticResource Text}" VerticalAlignment="Bottom" />
                        <TextBlock x:Name="NameEnText" FontSize="15" FontWeight="Normal"
                                   Foreground="{StaticResource Accent}" Margin="8,0,0,2"
                                   VerticalAlignment="Bottom" />
                        <TextBlock x:Name="CodeBadgeText" Style="{StaticResource Caption}"
                                   Foreground="{StaticResource Muted}" Margin="8,0,0,3"
                                   VerticalAlignment="Bottom" />
                    </StackPanel>

                    <!-- SubCategory, Price, Weight, Shelf Life Strip -->
                    <WrapPanel Margin="0,6,0,0">
                        <Border Background="{StaticResource Surface}" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                            <TextBlock x:Name="SubCategoryText" FontSize="11" Foreground="{StaticResource Text}" />
                        </Border>
                        <Border Background="{StaticResource Surface}" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                            <TextBlock x:Name="PriceTagText" FontSize="11" Foreground="{StaticResource Accent}" FontWeight="SemiBold" />
                        </Border>
                        <Border Background="{StaticResource Surface}" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                            <TextBlock x:Name="ShelfLifeTagText" FontSize="11" Foreground="{StaticResource Muted}" />
                        </Border>
                        <Border Background="{StaticResource Surface}" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                            <TextBlock x:Name="WeightTagText" FontSize="11" Foreground="{StaticResource Muted}" />
                        </Border>
                    </WrapPanel>
                </StackPanel>

                <!-- Inventory Count in Current City -->
                <Border Grid.Column="2" Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource Line}" BorderThickness="1"
                        CornerRadius="6" Padding="12,8" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="HÀNH TRANG SỞ TẠI" FontSize="10" Foreground="{StaticResource Muted}"
                                   HorizontalAlignment="Center" FontWeight="SemiBold" />
                        <TextBlock x:Name="BagQuantityText" Text="0 đơn vị" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource Text}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===== Body Content (Scrollable) ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">

                <!-- 1. Visual Illustration Banner & Lore Description -->
                <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="🖼️ HÌNH MINH HỌA &amp; ĐIỂN TÍCH KỲ VẬT"
                                       FontWeight="Bold" FontSize="12" Foreground="{StaticResource Accent}" />
                            <TextBlock Text="Khắc họa cổ lục Tam Quốc" FontSize="11" Foreground="{StaticResource Muted}"
                                       HorizontalAlignment="Right" />
                        </DockPanel>

                        <!-- ASCII Visual Art Box -->
                        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource AccentSoft}"
                                BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                            <TextBlock x:Name="AsciiIllustrationText"
                                       FontFamily="Consolas, Cascadia Mono, Lucida Console, Courier New"
                                       FontSize="12" LineHeight="16"
                                       Foreground="{StaticResource Accent}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Left" />
                        </Border>

                        <TextBlock x:Name="LoreDescriptionText" TextWrapping="Wrap"
                                   FontSize="13" LineHeight="20" Foreground="{StaticResource Text}" />
                    </StackPanel>
                </Border>

                <!-- 2. Detailed Parameters & Specifications -->
                <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="📊 THÔNG SỐ KỸ THUẬT &amp; CÔNG DỤNG ĐẶC THÙ"
                                   FontWeight="Bold" FontSize="12" Foreground="{StaticResource Accent}" Margin="0,0,0,10" />

                        <ItemsControl x:Name="DetailedStatsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Value}" TextAlignment="Right"
                                                   FontWeight="SemiBold" Foreground="{StaticResource Text}"
                                                   DockPanel.Dock="Right" MaxWidth="440" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Key}" FontSize="12"
                                                   Foreground="{StaticResource Muted}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 3. Sourcing & Acquisition -->
                <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="🗺️ NGUỒN GỐC &amp; PHƯƠNG THỨC THU THẬP"
                                   FontWeight="Bold" FontSize="12" Foreground="{StaticResource Accent}" Margin="0,0,0,6" />
                        <TextBlock x:Name="SourcingText" TextWrapping="Wrap" FontSize="12.5"
                                   LineHeight="18" Foreground="{StaticResource Text}" />
                    </StackPanel>
                </Border>

                <!-- 4. Practical Usage -->
                <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="💡 THAO TÁC SỬ DỤNG TRONG GAME"
                                   FontWeight="Bold" FontSize="12" Foreground="{StaticResource Accent}" Margin="0,0,0,6" />
                        <TextBlock x:Name="UsageText" TextWrapping="Wrap" FontSize="12.5"
                                   LineHeight="18" Foreground="{StaticResource Text}" />
                    </StackPanel>
                </Border>

                <!-- 5. Future Upgrade Roadmap (Extensible Hub) -->
                <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Accent}"
                        BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="🚀 TIỀM NĂNG PHÁT TRIỂN &amp; NÂNG CẤP (UPGRADE HUB)"
                                       FontWeight="Bold" FontSize="12" Foreground="{StaticResource Accent}" />
                            <Border Background="{StaticResource AccentSoft}" CornerRadius="4" Padding="6,1" HorizontalAlignment="Right">
                                <TextBlock Text="SẴN SÀNG MỞ RỘNG" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                            </Border>
                        </DockPanel>
                        <TextBlock x:Name="UpgradeRoadmapText" TextWrapping="Wrap" FontSize="12.5"
                                   LineHeight="18" Foreground="{StaticResource Text}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ===== Footer: Action Buttons ===== -->
        <Border Grid.Row="2" Padding="0,10,0,0" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock Text="Phím ESC để đóng cửa sổ · Bách Vật Đồ Giám SimT"
                           VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource Muted}" />
                <Button Content="Đóng Đồ Giám" Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Right" Padding="18,6"
                        Click="CloseButton_Click" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
