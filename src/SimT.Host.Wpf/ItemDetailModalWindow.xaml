<Window x:Class="SimT.Host.Wpf.ItemDetailModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bách Vật Đồ Giám — Tra Cứu Kỳ Vật &amp; Nông Cụ"
        Height="740" Width="840"
        MinHeight="620" MinWidth="740"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid Margin="18,14,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Header: Avatar Glyph, Identity, Category, Base Price & Badges ===== -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceAlt}"
                BorderBrush="{StaticResource Line}" BorderThickness="1"
                CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Icon Box -->
                <Border Grid.Column="0" Width="68" Height="68"
                        Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource Accent}" BorderThickness="2"
                        CornerRadius="8" Margin="0,0,14,0"
                        VerticalAlignment="Center">
                    <Grid>
                        <TextBlock x:Name="IconGlyphText" Text="📦"
                                   FontSize="34"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Border Background="{StaticResource AccentSoft}" CornerRadius="0,0,6,0"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Padding="4,1">
                            <TextBlock x:Name="CategoryTagSmall" Text="KỲ VẬT" FontSize="9"
                                       Foreground="{StaticResource Accent}" FontWeight="Bold" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Names & Overview -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="NameViText" Style="{StaticResource Display}" FontSize="20"
                                   Foreground="{StaticResource Text}" VerticalAlignment="Bottom" />
                        <TextBlock x:Name="NameEnText" FontSize="15" FontWeight="Normal"
                                   Foreground="{StaticResource Accent}" Margin="8,0,0,2"
                                   VerticalAlignment="Bottom" />
                        <TextBlock x:Name="CodeBadgeText" Style="{StaticResource Caption}"
                                   Foreground="{StaticResource Muted}" Margin="8,0,0,3"
                                   VerticalAlignment="Bottom" />
                    </StackPanel>

                    <!-- SubCategory, Price, Weight, Shelf Life Strip -->
                    <WrapPanel Margin="0,6,0,0">
                        <Border Background="{StaticResource Surface}" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                            <TextBlock x:Name="SubCategoryText" FontSize="11" Foreground="{StaticResource Text}" />
                        </Border>
                        <Border Background="{StaticResource Surface}" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                            <TextBlock x:Name="PriceTagText" FontSize="11" Foreground="{StaticResource Accent}" FontWeight="SemiBold" />
                        </Border>
                        <Border Background="{StaticResource Surface}" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                            <TextBlock x:Name="ShelfLifeTagText" FontSize="11" Foreground="{StaticResource Muted}" />
                        </Border>
                        <Border Background="{StaticResource Surface}" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                            <TextBlock x:Name="WeightTagText" FontSize="11" Foreground="{StaticResource Muted}" />
                        </Border>
                    </WrapPanel>
                </StackPanel>

                <!-- Inventory & Warehouse Count in Current City -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 1. Bag box -->
                    <Border Background="{StaticResource Surface}"
                            BorderBrush="{StaticResource Line}" BorderThickness="1"
                            CornerRadius="6" Padding="12,8" Margin="0,0,8,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🎒 TRONG TÚI" FontSize="10" Foreground="{StaticResource Muted}"
                                       HorizontalAlignment="Center" FontWeight="SemiBold" />
                            <TextBlock x:Name="BagQuantityText" Text="0 đơn vị" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource Text}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 2. Warehouse box -->
                    <Border Background="{StaticResource Surface}"
                            BorderBrush="{StaticResource Line}" BorderThickness="1"
                            CornerRadius="6" Padding="12,8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🏪 TRONG KHO" FontSize="10" Foreground="{StaticResource Muted}"
                                       HorizontalAlignment="Center" FontWeight="SemiBold" />
                            <TextBlock x:Name="WarehouseQuantityText" Text="0 đơn vị" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource Text}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            <TextBlock x:Name="WarehouseCapacitySummaryText" Text="Kho: 0/50" FontSize="9"
                                       Foreground="{StaticResource Accent}" HorizontalAlignment="Center" Margin="0,1,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Body Content (Scrollable) ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">

                <!-- 0. Warehouse Transfer Controls Card: Trao đổi Túi <-> Kho -->
                <Border x:Name="WarehouseTransferCard" Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource AccentSoft}"
                        BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header: Title & Warehouse status -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="🔄 TRAO ĐỔI KHO &amp; HÀNH TRANG (ĐIỀU CHUYỂN HÀNG HÓA)"
                                       FontWeight="Bold" FontSize="12" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                            <TextBlock x:Name="WarehouseStatusBadge" Text="Sức chứa: 0/50 đơn vị"
                                       FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </DockPanel>

                        <!-- Unrented State Panel -->
                        <Border x:Name="UnrentedWarehousePanel" Grid.Row="1" Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,4">
                            <DockPanel>
                                <Button x:Name="RentWarehouseButton" Content="🔑 Thuê Kho Ngay (120 Quan/tháng)"
                                        Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" Padding="14,6" Margin="10,0,0,0"
                                        Click="RentWarehouse_Click" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="⚠️ Chưa thuê kho thương điếm tại thành này" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Loss}" />
                                    <TextBlock Text="Thuê kho để cất giữ nông sản &amp; vật phẩm, tránh quá tải hành trang và giảm rủi ro cướp bóc."
                                               FontSize="11.5" Foreground="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Rented Action Controls Grid -->
                        <Grid x:Name="RentedWarehousePanel" Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Cột Gửi Vào Kho: Túi -> Kho -->
                            <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                                    BorderThickness="1" CornerRadius="6" Padding="12,8">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="📥 GỬI VÀO KHO (Túi ➔ Kho)" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource Text}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="AvailableInBagText" Text="Có: 0" FontSize="10.5" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <WrapPanel>
                                        <Button x:Name="StoreOneButton" Content="Gửi 1" Style="{StaticResource ChipButton}" Margin="0,0,6,4" Padding="10,4" Click="StoreOne_Click" />
                                        <Button x:Name="StoreFiveButton" Content="Gửi 5" Style="{StaticResource ChipButton}" Margin="0,0,6,4" Padding="10,4" Click="StoreFive_Click" />
                                        <Button x:Name="StoreAllButton" Content="Gửi Hết" Style="{StaticResource ChipButton}" Margin="0,0,6,4" Padding="10,4" Click="StoreAll_Click" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Cột Lấy Ra Túi: Kho -> Túi -->
                            <Border Grid.Column="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                                    BorderThickness="1" CornerRadius="6" Padding="12,8">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="📤 LẤY RA TÚI (Kho ➔ Túi)" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource Text}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="AvailableInWarehouseText" Text="Kho: 0" FontSize="10.5" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <WrapPanel>
                                        <Button x:Name="TakeOneButton" Content="Lấy 1" Style="{StaticResource ChipButton}" Margin="0,0,6,4" Padding="10,4" Click="TakeOne_Click" />
                                        <Button x:Name="TakeFiveButton" Content="Lấy 5" Style="{StaticResource ChipButton}" Margin="0,0,6,4" Padding="10,4" Click="TakeFive_Click" />
                                        <Button x:Name="TakeAllButton" Content="Lấy Hết" Style="{StaticResource ChipButton}" Margin="0,0,6,4" Padding="10,4" Click="TakeAll_Click" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Feedback Toast / Notice Banner -->
                        <Border x:Name="TransferFeedbackBorder" Grid.Row="2" Background="{StaticResource AccentSoft}"
                                BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,8,0,0"
                                Visibility="Collapsed">
                            <TextBlock x:Name="TransferFeedbackText" Text="Đã chuyển thành công." FontSize="11.5" Foreground="{StaticResource Accent}" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                </Border>

                <!-- 1. Visual Illustration Banner & Lore Description -->
                <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="🖼️ HÌNH MINH HỌA &amp; ĐIỂN TÍCH KỲ VẬT"
                                       FontWeight="Bold" FontSize="12" Foreground="{StaticResource Accent}" />
                            <TextBlock Text="Khắc họa cổ lục Tam Quốc" FontSize="11" Foreground="{StaticResource Muted}"
                                       HorizontalAlignment="Right" />
                        </DockPanel>

                        <!-- ASCII Visual Art Box -->
                        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource AccentSoft}"
                                BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <TextBlock x:Name="AsciiIllustrationText" FontFamily="Consolas, Cascadia Code, Courier New"
                                           FontSize="11.5" LineHeight="14" Foreground="{StaticResource Accent}"
                                           TextWrapping="NoWrap" />
                            </ScrollViewer>
                        </Border>

                        <!-- Lore Text -->
                        <TextBlock x:Name="LoreDescriptionText" TextWrapping="Wrap" FontSize="13"
                                   LineHeight="19" Foreground="{StaticResource Text}" FontStyle="Italic" />
                    </StackPanel>
                </Border>

                <!-- 2. Detailed Technical & Economic Specs -->
                <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="📊 THÔNG SỐ ĐẶC TÍNH &amp; KINH TẾ QUÂN SỰ"
                                   FontWeight="Bold" FontSize="12" Foreground="{StaticResource Accent}" Margin="0,0,0,8" />
                        <ItemsControl x:Name="DetailedStatsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                                            BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,6">
                                        <DockPanel>
                                            <TextBlock Text="{Binding Key}" FontWeight="SemiBold" FontSize="12"
                                                       Foreground="{StaticResource Text}" Width="160" />
                                            <TextBlock Text="{Binding Value}" FontSize="12"
                                                       Foreground="{StaticResource Accent}" TextWrapping="Wrap" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 3. Sourcing & Gathering Guide -->
                <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="🗺️ NGUỒN GỐC &amp; PHƯƠNG THỨC THU THẬP"
                                   FontWeight="Bold" FontSize="12" Foreground="{StaticResource Accent}" Margin="0,0,0,6" />
                        <TextBlock x:Name="SourcingText" TextWrapping="Wrap" FontSize="12.5"
                                   LineHeight="18" Foreground="{StaticResource Text}" />
                    </StackPanel>
                </Border>

                <!-- 4. Practical Usage -->
                <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="💡 THAO TÁC SỬ DỤNG TRONG GAME"
                                   FontWeight="Bold" FontSize="12" Foreground="{StaticResource Accent}" Margin="0,0,0,6" />
                        <TextBlock x:Name="UsageText" TextWrapping="Wrap" FontSize="12.5"
                                   LineHeight="18" Foreground="{StaticResource Text}" />
                    </StackPanel>
                </Border>

                <!-- 5. Future Upgrade Roadmap (Extensible Hub) -->
                <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Accent}"
                        BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="🚀 TIỀM NĂNG PHÁT TRIỂN &amp; NÂNG CẤP (UPGRADE HUB)"
                                       FontWeight="Bold" FontSize="12" Foreground="{StaticResource Accent}" />
                            <Border Background="{StaticResource AccentSoft}" CornerRadius="4" Padding="6,1" HorizontalAlignment="Right">
                                <TextBlock Text="SẴN SÀNG MỞ RỘNG" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                            </Border>
                        </DockPanel>
                        <TextBlock x:Name="UpgradeRoadmapText" TextWrapping="Wrap" FontSize="12.5"
                                   LineHeight="18" Foreground="{StaticResource Text}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ===== Footer: Action Buttons ===== -->
        <Border Grid.Row="2" Padding="0,10,0,0" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock Text="Phím ESC để đóng cửa sổ · Bách Vật Đồ Giám &amp; Kho Thương Điếm SimT"
                           VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource Muted}" />
                <Button Content="Đóng Đồ Giám" Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Right" Padding="18,6"
                        Click="CloseButton_Click" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
