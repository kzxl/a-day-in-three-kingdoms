<local:HubModalWindowBase x:Class="SimT.Host.Wpf.FactionDetailModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SimT.Host.Wpf"
        xmlns:controls="clr-namespace:SimT.Host.Wpf.Controls"
        Title="Chư Hầu Minh Hội · Hồ Sơ Thế Lực &amp; Cờ Hiệu Minh Chủ"
        Height="720" Width="920"
        MinHeight="620" MinWidth="820"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= ROW 0: GAME HUB HEADER ================= -->
        <controls:GameHubHeader Grid.Row="0" x:Name="HubHeader" />

        <!-- ================= ROW 1: FACTION DOSSIER ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== LEFT COLUMN: WARLORD LEADER & MILITARY POWER ===== -->
            <Border Grid.Column="0" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="8" Padding="16,14" Margin="0,0,12,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="MINH CHỦ CHƯ HẦU &amp; CỜ HIỆU QUÂN CƠ"
                                   Style="{StaticResource Overline}" Foreground="{StaticResource Accent}" Margin="0,0,0,10" />

                        <!-- Warlord Card -->
                        <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="64" Height="64"
                                            x:Name="LeaderAvatarBox"
                                            Background="{StaticResource Bg}"
                                            BorderBrush="{StaticResource Accent}" BorderThickness="2"
                                            CornerRadius="8" Margin="0,0,14,0"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="LeaderAvatarText" Text="主"
                                                   FontSize="32" FontWeight="Bold"
                                                   Foreground="{StaticResource Accent}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="LeaderTitleText" Text="Minh Chủ Chư Hầu"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Accent}" />
                                        <TextBlock x:Name="LeaderNameText" Text="Tào Tháo (Mạnh Đức)"
                                                   FontSize="18" FontWeight="Bold"
                                                   Foreground="{StaticResource Text}" Margin="0,1,0,3" />
                                        <TextBlock x:Name="FactionIdealText" Text="Lý Tưởng: Thâu Tóm Sơn Hà"
                                                   Style="{StaticResource Caption}" Foreground="{StaticResource Muted}" />
                                    </StackPanel>
                                </Grid>

                                <!-- Warlord 8-Pillar Radar Chart -->
                                <local:RadarChartControl x:Name="WarlordRadarChart" Height="130" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Military & Treasury Metrics -->
                        <UniformGrid Columns="2" Margin="0,0,0,12">
                            <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                                    BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,4,6">
                                <StackPanel>
                                    <TextBlock Text="👥 QUÂN SỐ THẾ LỰC" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                                    <TextBlock x:Name="FactionTroopsText" Text="45,000" Style="{StaticResource NumberLarge}" Foreground="{StaticResource Accent}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                                    BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="4,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="💰 NGÂN KHỐ QUÂN NHU" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Gain}" />
                                    <TextBlock x:Name="FactionTreasuryText" Text="120,000 Quan" Style="{StaticResource NumberLarge}" Foreground="{StaticResource Gain}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                                    BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,4,4,0">
                                <StackPanel>
                                    <TextBlock Text="🏰 THÀNH TRÌ KIỂM SOÁT" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                                    <TextBlock x:Name="TerritoryCountText" Text="3 Châu Quận" Style="{StaticResource NumberLarge}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                                    BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="4,4,0,0">
                                <StackPanel>
                                    <TextBlock Text="🚩 ĐÔ THÀNH THỦ PHỦ" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                                    <TextBlock x:Name="CapitalCityText" Text="Hứa Xương" Style="{StaticResource NumberLarge}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Diplomatic Stance -->
                        <TextBlock Text="Tôn Chỉ Hoạt Động &amp; Ngoại Giao" Style="{StaticResource Caption}"
                                   Foreground="{StaticResource Muted}" Margin="0,0,0,4" />
                        <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" CornerRadius="6" Padding="12,10">
                            <TextBlock x:Name="FactionBioText"
                                       Text="Thế lực cát cứ một phương, sở hữu binh hùng tướng mạnh, hiệu lệnh thiên hạ chư hầu."
                                       FontSize="12" LineHeight="19"
                                       Foreground="{StaticResource Text}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ===== RIGHT COLUMN: CONTROLLED TERRITORIES & OFFICERS ===== -->
            <Border Grid.Column="1" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="8" Padding="18,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Territories -->
                            <TextBlock Text="🏰 LÃNH ĐỊA VÀ CHÂU QUẬN TRỰC THUỘC"
                                       Style="{StaticResource Overline}" Foreground="{StaticResource Accent}" Margin="0,0,0,8" />
                            <ItemsControl x:Name="TerritoriesList" Margin="0,0,0,16">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                                                BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,4">
                                            <DockPanel>
                                                <TextBlock Text="🏯" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding NameVi}" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Text}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding RegionVi}" Margin="8,0,0,0" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding DefenseText}" HorizontalAlignment="Right" Style="{StaticResource Caption}" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Notable Officers -->
                            <TextBlock Text="⚔ DANH TƯỚNG &amp; MƯU SĨ TRONG PHƯƠNG KHỐI"
                                       Style="{StaticResource Overline}" Margin="0,0,0,8" />
                            <ItemsControl x:Name="OfficersList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                                                BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,4">
                                            <DockPanel>
                                                <Border Width="32" Height="32" Background="{StaticResource Bg}"
                                                        BorderBrush="{StaticResource Line}" BorderThickness="1"
                                                        CornerRadius="4" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding AvatarChar}" FontSize="15" FontWeight="Bold"
                                                               Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="{Binding NameVi}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Text}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Role}" Margin="8,0,0,0" FontSize="10.5" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding WarText}" HorizontalAlignment="Right" Style="{StaticResource Caption}" Foreground="{StaticResource Loss}" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom Action Strip -->
                    <Border Grid.Row="1" Background="{StaticResource SurfaceAlt}"
                            BorderBrush="{StaticResource Line}" BorderThickness="1"
                            CornerRadius="8" Padding="12,10" Margin="0,12,0,0">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                <TextBlock x:Name="AllegianceStatusText" Text="○ Bạn đang là hiệp khách tự do"
                                           Style="{StaticResource Caption}" Foreground="{StaticResource Muted}" />
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="JoinFactionBtn" Content="🤝 Gia Nhập Phe Phái"
                                        Style="{StaticResource PrimaryButton}"
                                        FontWeight="Bold" Padding="16,8" Margin="0,0,8,0"
                                        Click="JoinFaction_Click" />
                                <Button Content="Trở Về"
                                        Style="{StaticResource GhostButton}"
                                        Padding="16,8"
                                        Click="Close_Click" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</local:HubModalWindowBase>
