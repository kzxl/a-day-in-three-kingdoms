<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>SimT.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SimT.Contracts\SimT.Contracts.csproj" />
    <ProjectReference Include="..\SimT.Core\SimT.Core.csproj" />
  </ItemGroup>

  <!-- Modules are copied into Modules/ as artefacts, never referenced at compile time.
       Host and CLI must stay unaware of module types. -->
  <ItemGroup>
    <ModuleProject Include="..\SimT.Modules.Base.Content\SimT.Modules.Base.Content.csproj" />
    <ModuleProject Include="..\SimT.Modules.Base.World\SimT.Modules.Base.World.csproj" />
    <ModuleProject Include="..\SimT.Modules.Base.Player\SimT.Modules.Base.Player.csproj" />
    <ModuleProject Include="..\SimT.Modules.Base.Npc\SimT.Modules.Base.Npc.csproj" />
    <ModuleProject Include="..\SimT.Modules.Dlc.Economy\SimT.Modules.Dlc.Economy.csproj" />
    <ModuleProject Include="..\SimT.Modules.Dlc.Character\SimT.Modules.Dlc.Character.csproj" />
    <ModuleProject Include="..\SimT.Modules.Dlc.Politics\SimT.Modules.Dlc.Politics.csproj" />
    <ModuleProject Include="..\SimT.Modules.Dlc.Society\SimT.Modules.Dlc.Society.csproj" />
    <ModuleProject Include="..\SimT.Modules.Dlc.Military\SimT.Modules.Dlc.Military.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="@(ModuleProject)" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <Target Name="CopyModules" AfterTargets="Build">
    <ItemGroup>
      <ModuleArtifact Include="@(ModuleProject->'%(RootDir)%(Directory)bin\$(Configuration)\net8.0\%(Filename).dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(ModuleArtifact)" DestinationFolder="$(OutDir)Modules" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <None Include="..\..\assets\**\*" LinkBase="assets" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
