<Project>

  <PropertyGroup>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>false</InvariantGlobalization>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <NoWarn>$(NoWarn);CA1707;CA2007;CA1002;CA1062;CA1303;CA1848;CA1852</NoWarn>
  </PropertyGroup>

  <!-- Version single source of truth (R_VER). Bump all three together. -->
  <PropertyGroup>
    <Version>0.2.2</Version>
    <AssemblyVersion>0.2.2.0</AssemblyVersion>
    <FileVersion>0.2.2.0</FileVersion>
    <InformationalVersion>0.2.2</InformationalVersion>
    <Product>SimT</Product>
    <Company>SimT</Company>
  </PropertyGroup>

</Project>
