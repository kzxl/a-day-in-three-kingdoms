<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <!-- Tests ARE allowed to reference modules: that is how the gate inspects assemblies. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\SimT.Contracts\SimT.Contracts.csproj" />
    <ProjectReference Include="..\..\src\SimT.Core\SimT.Core.csproj" />
    <ProjectReference Include="..\..\src\SimT.Modules.Base.Content\SimT.Modules.Base.Content.csproj" />
    <ProjectReference Include="..\..\src\SimT.Modules.Base.World\SimT.Modules.Base.World.csproj" />
    <ProjectReference Include="..\..\src\SimT.Modules.Base.Player\SimT.Modules.Base.Player.csproj" />
    <ProjectReference Include="..\..\src\SimT.Modules.Base.Npc\SimT.Modules.Base.Npc.csproj" />
    <ProjectReference Include="..\..\src\SimT.Modules.Dlc.Economy\SimT.Modules.Dlc.Economy.csproj" />
    <ProjectReference Include="..\..\src\SimT.Modules.Dlc.Character\SimT.Modules.Dlc.Character.csproj" />
    <ProjectReference Include="..\..\src\SimT.Modules.Dlc.Power\SimT.Modules.Dlc.Power.csproj" />
    <ProjectReference Include="..\..\src\SimT.Modules.Dlc.Society\SimT.Modules.Dlc.Society.csproj" />
  </ItemGroup>

  <!-- Pure host policy is tested without loading WPF, NAudio, or an output device. -->
  <ItemGroup>
    <Compile Include="..\..\src\SimT.Host.Wpf\Audio\AudioCatalog.cs" Link="Audio/AudioCatalog.cs" />
    <Compile Include="..\..\src\SimT.Host.Wpf\Audio\AudioSettings.cs" Link="Audio/AudioSettings.cs" />
    <Compile Include="..\..\src\SimT.Host.Wpf\Audio\AudioScenePolicy.cs" Link="Audio/AudioScenePolicy.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
